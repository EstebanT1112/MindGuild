import React from 'react';
import { StatusBar } from 'expo-status-bar';
import { StyleSheet, View } from 'react-native';
// Importamos la pantalla que estuvimos maquetando[cite: 5]
import HomeScreen from './src/features/friends/screens/HomeScreen';

export default function App() {
  return (
    <View style={styles.container}>
      {/* StatusBar para que los iconos de la batería/hora se vean blancos[cite: 3] */}
      <StatusBar style="light" />
      <HomeScreen />
    </View>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: '#1a1d29', // Tu color de fondo del Design System[cite: 3]
  },
});

TypeScript
import { createBottomTabNavigator } from "@react-navigation/bottom-tabs";
import { Text, View } from "react-native";
import HomeScreen from "../features/home/screens/HomeScreen";
// 1. Importamos tu pantalla real
import FriendsScreen from "../features/friends/screens/FriendsScreen";

const Tab = createBottomTabNavigator();

function Placeholder({ title }: { title: string }) {
  return (
    <View style={{ flex: 1, alignItems: "center", justifyContent: "center" }}>
      <Text>{title}</Text>
    </View>
  );
}

export default function TabNavigator() {
  return (
    <Tab.Navigator
      screenOptions={{
        headerShown: false,
        tabBarStyle: {
          backgroundColor: "#111",
          borderTopColor: "#222",
        },
        tabBarActiveTintColor: "#22c55e",
        tabBarInactiveTintColor: "#888",
      }}
    >
      <Tab.Screen name="Home" component={HomeScreen} />
      <Tab.Screen name="Salas">
        {() => <Placeholder title="Salas" />}
      </Tab.Screen>
      <Tab.Screen name="Ranking">
        {() => <Placeholder title="Ranking" />}
      </Tab.Screen>
      
      {/* 2. Conectamos Amigos a tu pantalla real[cite: 1] */}
      <Tab.Screen name="Amigos" component={FriendsScreen} />
    </Tab.Navigator>
  );
}
🛠️ Paso 2: El código de la pantalla (FriendsScreen.tsx)
Ahora abrí src/features/friends/screens/FriendsScreen.tsx y pegá este código nativo. He mantenido tus imports de archivos separados para colors, spacing, etc., tal cual los tenés en tu carpeta theme:

TypeScript
import React from 'react';
import { View, Text, StyleSheet, ScrollView, Pressable, SafeAreaView } from 'react-native';
import { ArrowLeft, Users, Flame, Trophy, Check, X, UserPlus } from 'lucide-react-native';
// Imports desde tus archivos individuales
import { colors } from '../../../theme/colors';
import { spacing } from '../../../theme/spacing';
import { radius } from '../../../theme/radius';

export default function FriendsScreen() {
  const pendingRequests = [
    { id: 1, username: "maria_lopez", avatar: "M", mutualFriends: 2 },
    { id: 2, username: "carlos_ruiz", avatar: "C", mutualFriends: 1 },
  ];

  const friends = [
    { id: 1, username: "kenji_tanaka", avatar: "K", streak: 7, level: 8, hours: 15.5, status: 'online' },
    { id: 2, username: "yuki_yamamoto", avatar: "Y", streak: 5, level: 6, hours: 12.3, status: 'online' },
  ];

  return (
    <SafeAreaView style={{ flex: 1, backgroundColor: colors.background }}>
      <View style={styles.container}>
        {/* Header Figma */}
        <View style={styles.header}>
          <Pressable style={styles.backBtn}><ArrowLeft color="#888" size={20} /></Pressable>
          <View style={styles.headerTitle}><Users color="#22c55e" size={20} /><Text style={styles.headerText}>AMIGOS</Text></View>
          <View style={styles.coinBadge}><Text style={styles.coinText}>H 1,250</Text></View>
        </View>

        <ScrollView showsVerticalScrollIndicator={false}>
          {/* Solicitudes */}
          <Text style={styles.sectionTitle}>SOLICITUDES PENDIENTES ({pendingRequests.length})</Text>
          {pendingRequests.map(req => (
            <View key={req.id} style={styles.requestCard}>
              <View style={styles.userRow}>
                <View style={[styles.avatar, { backgroundColor: '#3b82f6' }]}><Text style={styles.avatarLetter}>{req.avatar}</Text></View>
                <View><Text style={styles.username}>@{req.username}</Text><Text style={styles.subText}>{req.mutualFriends} en común</Text></View>
              </View>
              <View style={styles.actions}>
                <Pressable style={[styles.btn, { backgroundColor: '#22c55e' }]}><Check color="white" size={16} /><Text style={styles.btnText}>Aceptar</Text></Pressable>
                <Pressable style={[styles.btn, { backgroundColor: '#222' }]}><X color="#888" size={16} /><Text style={styles.btnText}>Rechazar</Text></Pressable>
              </View>
            </View>
          ))}

          {/* Amigos */}
          <Text style={styles.sectionTitle}>MIS AMIGOS ({friends.length})</Text>
          {friends.map(friend => (
            <View key={friend.id} style={styles.friendCard}>
              <View style={styles.userRow}>
                <View style={[styles.avatar, { backgroundColor: '#22c55e' }]}><Text style={styles.avatarLetter}>{friend.avatar}</Text></View>
                <View>
                  <Text style={styles.username}>@{friend.username}</Text>
                  <View style={styles.badgeRow}>
                    <View style={styles.levelBadge}><Text style={styles.levelText}>Nivel {friend.level}</Text></View>
                    <View style={styles.streakBadge}><Flame color="#fb923c" size={12} /><Text style={styles.streakText}>{friend.streak}d</Text></View>
                  </View>
                </View>
              </View>
              <View style={styles.statsRow}>
                <View style={styles.stat}><Trophy color="#facc15" size={16} /><Text style={styles.statText}>{friend.hours}h</Text></View>
                <Pressable style={styles.profileBtn}><Text style={styles.profileBtnText}>Ver Perfil</Text></Pressable>
              </View>
            </View>
          ))}
        </ScrollView>

        <Pressable style={styles.fab}><UserPlus color="white" size={24} /></Pressable>
      </View>
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, paddingHorizontal: 16 },
  header: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', paddingVertical: 12 },
  headerTitle: { flexDirection: 'row', alignItems: 'center', gap: 8 },
  headerText: { color: 'white', fontWeight: 'bold', fontSize: 18 },
  coinBadge: { backgroundColor: '#222', paddingHorizontal: 12, paddingVertical: 6, borderRadius: 20 },

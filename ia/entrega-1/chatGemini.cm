    marginHorizontal: 16,
    borderRadius: 8,
  },
  title: {
    fontSize: 18,
    color: '#fff',
    fontFamily: 'Muli-Regular',
  },
});

export default ProfileScreen;
🧠 ¿Por qué funciona esto?
La clave es la propiedad stickyHeaderIndices={[0]} de la FlatList. Le dice a React Native: "Agarrá el primer componente que te pasé en ListHeaderComponent (el avatar y los botones) y, cuando el usuario haga scroll, clavalo en la parte superior de la pantalla (top: 0) de forma nativa". El contenido de DATA pasará por debajo sin mover la cabecera.

💡 Opción 2: Cabecera Estática + Contenido con Scroll (Fácil si es contenido estático)
Si el contenido de abajo no viene de una lista de datos (son solo bloques de texto o componentes estáticos), podés usar esta estructura más simple:

JavaScript
import React from 'react';
import { StyleSheet, View, ScrollView } from 'react-native';

const ProfileScreen = () => {
  return (
    <View style={styles.container}>
      {/* 1. Cabecera FIJA (Fuera del ScrollView) */}
      <ProfileHeaderComponent /> 

      {/* 2. Todo lo que hace SCROLL (Dentro del ScrollView) */}
      <ScrollView style={styles.scrollView}>
        <MisionesBlock />
        <LogrosBlock />
        <EstadisticasBlock />
        {/* Agrega más contenido acá... */}
      </ScrollView>
    </View>
  );
};

const styles = StyleSheet.create({
  container: {
    flex: 1, // La pantalla principal ocupa todo
    backgroundColor: '#303030',
  },
  scrollView: {
    flex: 1, // El scroll ocupa el resto
  },
});
Probá una de estas dos estructuras y vas a lograr el efecto exacto que querés. ¡A meterle código! 🏎️🔥🏆

o necesitas otro archivi?

¡No hace falta ningún otro archivo, roro! Con el código de ProfileScreen.tsx que me pasaste se ve exactamente qué está pasando.

Al mirar tu código, el problema salta al toque: estás metiendo los botones de acción (actionButtons) y todo el detalle del usuario adentro del flujo normal del componente, y después clavás un <ScrollView> abajo.

¿Qué pasa con esto? Cuando el usuario baja, los botones se van para arriba y desaparecen porque no están configurados de forma fija, y si intentás fijar cosas por separado con CSS en React Native te suele romper el diseño en pantallas de distintos tamaños.

Como tu pantalla tiene una estructura mixta (los botones de editar/configuración arriba a la derecha, la info del usuario en el medio y una parva de estadísticas, medallas y barras abajo que sí o sí necesitan scroll), tenés que meter la cabecera fija de manera limpia.

La mejor forma de resolverlo en React Native manteniendo tu <ScrollView> actual es separar la pantalla en dos bloques usando flexbox: un bloque estático superior y el bloque con scroll abajo.

Modificá tu archivo ProfileScreen.tsx para que quede estructurado de esta manera:

TypeScript
// ... (mantené exactamente los mismos imports y la lógica de estados/fetch que ya tenés)

export default function ProfileScreen() {
    // ... (mantené toda tu lógica de states, tokens y handleSaveProfile igual)

    if (loading) {
        return (
            <ScreenLayout title="MI PERFIL" type="profiles">
                <View style={styles.loadingState}>
                    <ActivityIndicator color="#22c55e" />
                    <Text style={styles.loadingText}>Cargando perfil...</Text>
                </View>
            </ScreenLayout>
        );
    }

    return (
        <ScreenLayout title="MI PERFIL" type="profiles">
            {/* ─── BLOQUE SUPERIOR FIJO (No se mueve nunca al hacer scroll) ─── */}
            <View style={styles.fixedHeader}>
                <Text style={styles.headerSubtitle}>Opciones de cuenta</Text>
                <View style={styles.actionButtons}>
                    <Pressable
                        style={[styles.iconBtn, styles.editBtnActive]}
                        onPress={() => setEditModalVisible(true)}
                    >
                        <Edit2 color="#3b82f6" size={18} />
                    </Pressable>

                    <Pressable
                        style={styles.iconBtn}
                        onPress={() => setSettingsVisible(true)}
                    >
                        <Settings color="#94a3b8" size={18} />
                    </Pressable>
                </View>
            </View>

            {/* ─── BLOQUE INFERIOR CON SCROLL (Todo el contenido que desliza) ─── */}
            <ScrollView showsVerticalScrollIndicator={false} contentContainerStyle={{ paddingBottom: 40 }}>
                <View style={styles.profileSection}>
                    <View style={styles.avatarContainer}>
                        <View style={styles.avatarBorder}>
                            <Image source={{ uri: avatarUri }} style={styles.avatarImage} />
                        </View>
                        <View style={styles.levelBadge}>
                            <Text style={styles.levelText}>{profile?.village.village_level ?? 1}</Text>
                        </View>
                    </View>
                    <Text style={styles.userName}>{profile?.username ?? 'Usuario'}</Text>
                    <Text style={styles.userTag}>@{profile?.username ?? 'usuario'}</Text>
                    {!!profile?.bio && <Text style={styles.bioText}>{profile.bio}</Text>}
                    <View style={styles.ratingRow}>
                        <Star color="#facc15" fill="#facc15" size={16} />
                        <Text style={styles.ratingText}>{profile?.email}</Text>
                    </View>
                </View>

                <View style={styles.statsGrid}>
                    <StatCard icon={<Trophy color="#22c55e" size={24} />} value={`${profile?.total_study_minutes ?? 0}m`} label="Total Estudio" />
                    <StatCard icon={<Flame color="#fb923c" size={24} />} value={`${profile?.streak_days ?? 0} dias`} label="Racha Actual" />
                    <StatCard icon={<Medal color="#22c55e" size={24} />} value="0" label="Logros" />
                    <StatCard icon={<Castle color="#22c55e" size={24} />} value={`${profile?.village.village_level ?? 1}`} label="Nivel Aldea" />
                </View>

                <WeeklyProgress
                    data={[0, 0, 0, 0, 0, 0, profile?.weekly_stats.total_minutes ?? 0]}
                    totalMinutes={profile?.weekly_stats.total_minutes ?? 0}
                />

                <View style={styles.medalsSection}>
                    <View style={styles.sectionHeaderRow}>
                        <Medal color="#facc15" size={20} />
                        <Text style={styles.sectionTitle}>Medallas Desbloqueadas</Text>
                    </View>
                    <View style={styles.medalsGrid}>
                        {[
                            { name: '3 Dias Consecutivos', Icon: Flame, color: '#fb923c', unlocked: (profile?.streak_days ?? 0) >= 3 },
                            { name: 'Auditor Implacable', Icon: Target, color: '#3b82f6', unlocked: false },
                            { name: 'Estudiante Dedicado', Icon: Medal, color: '#22c55e', unlocked: (profile?.total_study_minutes ?? 0) > 0 },
                            { name: 'Maestro del Focus', Icon: Target, color: '#4b5563', unlocked: false },
                            { name: 'Racha de 7 dias', Icon: Zap, color: '#4b5563', unlocked: (profile?.streak_days ?? 0) >= 7 },
                            { name: 'Top 3 Ranking', Icon: Crown, color: '#4b5563', unlocked: false },
                        ].map((m, i) => (
                            <View key={i} style={[styles.medalCard, !m.unlocked && { opacity: 0.4 }]}>
                                <m.Icon color={m.color} size={30} />
                                <Text style={styles.medalName}>{m.name}</Text>
                            </View>
                        ))}
                    </View>
                </View>

                <View style={styles.villageCard}>
                    <Text style={styles.villageTitle}>Tu Aldea en Evolucion</Text>
                    <View style={styles.villageMainRow}>
                        <View style={styles.villageIconBox}>
                            <Castle color="#22c55e" size={46} />
                        </View>
                        <View style={styles.villageInfo}>
                            <View style={styles.levelRow}>
                                <Text style={styles.levelLabelText}>Nivel {profile?.village.village_level ?? 1}</Text>
                                <Text style={styles.percentageText}>{profile?.weekly_stats.total_minutes ?? 0}m</Text>
                            </View>
                            <View style={styles.progressBarBg}>
                                <View style={[styles.progressBarFill, { width: '40%' }]} />
                            </View>
                            <Text style={styles.nextLevelText}>Tiempo semanal registrado</Text>
                        </View>
                    </View>
                </View>
            </ScrollView>

            {/* ... (Mantené los modales de EditProfileModal y SettingsModal al final igual que antes) */}
        </ScreenLayout>
    );
}
🎨 Reemplazá y agregá estos estilos en tu StyleSheet:
Para que la separación no te rompa el alineado a la derecha ni te superponga el texto, cambiá los estilos de los botones por estos:

TypeScript
const styles = StyleSheet.create({
    // ... (mantené tus otros estilos igual)

    // Agregá este contenedor para el bloque fijo superior
    fixedHeader: {
        flexDirection: 'row',
        justifyContent: 'space-between',
        alignItems: 'center',
        paddingHorizontal: 4,
        paddingBottom: 15,
        backgroundColor: 'transparent', // Se fusiona con el fondo del ScreenLayout
        zIndex: 10, // Te asegura que quede siempre por encima de las tarjetas al scrollear
    },
    headerSubtitle: {
        color: '#64748b',
        fontSize: 14,
        fontWeight: '600'
    },
    actionButtons: {
        flexDirection: 'row',
        justifyContent: 'flex-end',
        gap: 10,
    },
    iconBtn: {
        width: 40, 
        height: 40, 
        borderRadius: 12,
        backgroundColor: '#1e293b', 
        alignItems: 'center', 
        justifyContent: 'center'
    },
    editBtnActive: { 
        borderColor: '#3b82f6', 
        borderWidth: 1 
    },

    // Modificá el profileSection para sacarle el margen negativo raro que tenía antes
    profileSection: { 
        alignItems: 'center', 
        marginBottom: 20,
        marginTop: 10 
    },
    
    // ... (el resto del StyleSheet queda exactamente igual)
});
🧠 ¿Por qué cambia el comportamiento con esto?
Al sacar los botones de acción (actionButtons) del contenedor <ScrollView> y dejarlos sueltos arriba, React Native los interpreta como un componente de altura fija. El <ScrollView> arranca inmediatamente abajo de ellos. Cuando tires el scroll para arriba, todo el bloque del avatar, los gráficos semanales y las medallas van a deslizarse pasando por debajo, pero los botones de editar y configurar se van a quedar totalmente inmóviles arriba a la derecha.

Cambiá esa estructura de contenedores en tu archivo y ya te queda la pantalla de perfil funcionando de forma súper profesional. ¡Mandale mecha! 🏎️🔥🏆

osea mejor pasame actualizado ese archivo bien, soo eso mejora

¡De una, roro! Acá tenés el archivo ProfileScreen.tsx completo y limpio con la reestructuración.

Separé los botones del flujo del scroll dejándolos en una cabecera fija (fixedHeader) justo arriba del <ScrollView>. De esta manera, cuando los usuarios deslicen hacia abajo para ver el progreso semanal, las medallas o la aldea, los botones de Editar Perfil y Configuración se van a quedar completamente quietos e inmóviles arriba a la derecha.

Copiá y pegá todo este bloque en tu archivo:

TypeScript
import React, { useEffect, useState } from 'react';
import {
    ActivityIndicator,
    Alert,
    Image,
    Pressable,
    ScrollView,
    StyleSheet,
    Text,
    View,
} from 'react-native';
import {
    Crown,
    Castle,
    Edit2,
    Flame,
    Medal,
    Settings,
    Star,
    Target,
    Trophy,
    Zap,
} from 'lucide-react-native';
import ScreenLayout from '../../../components/ui/ScreenLayout';
import { useAuthStore } from '../../../store/authStore';
import EditProfileModal from '../components/EditProfileModal';
import SettingsModal from '../components/SettingsModal';
import StatCard from '../components/StatCard';
import WeeklyProgress from '../components/WeeklyProgress';
import { fetchMyProfile, type FullProfile, updateMyProfile } from '../services/profileService';

const fallbackAvatar = 'https://ui-avatars.com/api/?background=1e293b&color=ffffff&name=MG';

export default function ProfileScreen() {
    const accessToken = useAuthStore(state => state.access_token);
    const setUser = useAuthStore(state => state.setUser);

    const [isEditModalVisible, setEditModalVisible] = useState(false);
    const [isSettingsVisible, setSettingsVisible] = useState(false);
    const [profile, setProfile] = useState<FullProfile | null>(null);
    const [loading, setLoading] = useState(true);

    const loadProfile = async () => {
        if (!accessToken) return;
        try {
            setLoading(true);
            const data = await fetchMyProfile(accessToken);
            setProfile(data);
        } catch (error) {
            console.error('Error al cargar perfil:', error);
            Alert.alert('Error', 'No se pudo cargar la información del perfil.');
        } finally {
            setLoading(false);
        }
    };

    useEffect(() => {
        loadProfile();
    }, [accessToken]);

    const handleSaveProfile = async (updatedData: { username: string; bio: string; avatar_url: string }) => {
        if (!accessToken) return;
        try {
            const updatedProfile = await updateMyProfile(accessToken, updatedData);
            setProfile(updatedProfile);
            setUser({
                username: updatedProfile.username,
                email: updatedProfile.email,
                avatar_url: updatedProfile.avatar_url,
            });
            Alert.alert('Éxito', 'Perfil actualizado correctamente.');
        } catch (error) {
            console.error('Error al actualizar perfil:', error);
            Alert.alert('Error', 'No se pudo actualizar el perfil.');
            throw error;
        }
    };

    if (loading) {
        return (
            <ScreenLayout title="MI PERFIL" type="profiles">
                <View style={styles.loadingState}>
                    <ActivityIndicator color="#22c55e" />
                    <Text style={styles.loadingText}>Cargando perfil...</Text>
                </View>
            </ScreenLayout>
        );
    }

    const avatarUri = profile?.avatar_url && profile.avatar_url.trim() !== '' 
        ? profile.avatar_url 
        : fallbackAvatar;

    return (
        <ScreenLayout title="MI PERFIL" type="profiles">
            
            {/* ─── CABECERA FIJA SUPERIOR (Opciones de cuenta) ─── */}
            <View style={styles.fixedHeader}>
                <Text style={styles.headerSubtitle}>Opciones de cuenta</Text>
                <View style={styles.actionButtons}>
                    <Pressable
                        style={[styles.iconBtn, styles.editBtnActive]}
                        onPress={() => setEditModalVisible(true)}
                    >
                        <Edit2 color="#3b82f6" size={18} />
                    </Pressable>

                    <Pressable
                        style={styles.iconBtn}
                        onPress={() => setSettingsVisible(true)}
                    >
                        <Settings color="#94a3b8" size={18} />
                    </Pressable>
                </View>
            </View>

            {/* ─── CONTENIDO CON SCROLL DEBAJO DE LOS BOTONES ─── */}
            <ScrollView showsVerticalScrollIndicator={false} contentContainerStyle={{ paddingBottom: 40 }}>
                
                {/* Información Principal del Perfil */}
                <View style={styles.profileSection}>
                    <View style={styles.avatarContainer}>
                        <View style={styles.avatarBorder}>
                            <Image source={{ uri: avatarUri }} style={styles.avatarImage} />
                        </View>
                        <View style={styles.levelBadge}>
                            <Text style={styles.levelText}>{profile?.village.village_level ?? 1}</Text>
                        </View>
                    </View>
                    <Text style={styles.userName}>{profile?.username ?? 'Usuario'}</Text>
                    <Text style={styles.userTag}>@{profile?.username ?? 'usuario'}</Text>
                    {!!profile?.bio && <Text style={styles.bioText}>{profile.bio}</Text>}
                    <View style={styles.ratingRow}>
                        <Star color="#facc15" fill="#facc15" size={16} />
                        <Text style={styles.ratingText}>{profile?.email}</Text>
                    </View>
                </View>

                {/* Grid de Estadísticas */}
                <View style={styles.statsGrid}>
                    <StatCard icon={<Trophy color="#22c55e" size={24} />} value={`${profile?.total_study_minutes ?? 0}m`} label="Total Estudio" />
                    <StatCard icon={<Flame color="#fb923c" size={24} />} value={`${profile?.streak_days ?? 0} días`} label="Racha Actual" />
                    <StatCard icon={<Medal color="#22c55e" size={24} />} value="0" label="Logros" />
                    <StatCard icon={<Castle color="#22c55e" size={24} />} value={`${profile?.village.village_level ?? 1}`} label="Nivel Aldea" />
                </View>

                {/* Progreso Semanal */}
                <WeeklyProgress
                    data={[0, 0, 0, 0, 0, 0, profile?.weekly_stats.total_minutes ?? 0]}
                    totalMinutes={profile?.weekly_stats.total_minutes ?? 0}
                />

                {/* Sección de Medallas */}
                <View style={styles.medalsSection}>
                    <View style={styles.sectionHeaderRow}>
                        <Medal color="#facc15" size={20} />
                        <Text style={styles.sectionTitle}>Medallas Desbloqueadas</Text>
                    </View>
                    <View style={styles.medalsGrid}>
                        {[
                            { name: '3 Días Consecutivos', Icon: Flame, color: '#fb923c', unlocked: (profile?.streak_days ?? 0) >= 3 },
                            { name: 'Auditor Implacable', Icon: Target, color: '#3b82f6', unlocked: false },
                            { name: 'Estudiante Dedicado', Icon: Medal, color: '#22c55e', unlocked: (profile?.total_study_minutes ?? 0) > 0 },
                            { name: 'Maestro del Focus', Icon: Target, color: '#4b5563', unlocked: false },
                            { name: 'Racha de 7 días', Icon: Zap, color: '#4b5563', unlocked: (profile?.streak_days ?? 0) >= 7 },
                            { name: 'Top 3 Ranking', Icon: Crown, color: '#4b5563', unlocked: false },
                        ].map((m, i) => (
                            <View key={i} style={[styles.medalCard, !m.unlocked && { opacity: 0.4 }]}>
                                <m.Icon color={m.color} size={30} />
                                <Text style={styles.medalName}>{m.name}</Text>
                            </View>
                        ))}
                    </View>
                </View>

                {/* Tarjeta del Estado de la Aldea */}
                <View style={styles.villageCard}>
                    <Text style={styles.villageTitle}>Tu Aldea en Evolución</Text>
                    <View style={styles.villageMainRow}>
                        <View style={styles.villageIconBox}>
                            <Castle color="#22c55e" size={46} />
                        </View>
                        <View style={styles.villageInfo}>
                            <View style={styles.levelRow}>
                                <Text style={styles.levelLabelText}>Nivel {profile?.village.village_level ?? 1}</Text>
                                <Text style={styles.percentageText}>{profile?.weekly_stats.total_minutes ?? 0}m</Text>
                            </View>
                            <View style={styles.progressBarBg}>
                                <View style={[styles.progressBarFill, { width: '40%' }]} />
                            </View>
                            <Text style={styles.nextLevelText}>Tiempo semanal registrado</Text>
                        </View>
                    </View>
                </View>
            </ScrollView>

            {/* Modales Modulares */}
            {profile && (
                <EditProfileModal
                    visible={isEditModalVisible}
                    onClose={() => setEditModalVisible(false)}
                    currentUsername={profile.username}
                    currentBio={profile.bio || ''}
                    currentAvatar={profile.avatar_url || ''}
                    onSave={handleSaveProfile}
                />
            )}

            <SettingsModal
                visible={isSettingsVisible}
                onClose={() => setSettingsVisible(false)}
            />
        </ScreenLayout>
    );
}

const styles = StyleSheet.create({
    loadingState: { flex: 1, justifyContent: 'center', alignItems: 'center', gap: 10 },
    loadingText: { color: '#64748b', fontSize: 16 },
    
    // Contenedor fijo de la cabecera
    fixedHeader: {
        flexDirection: 'row',
        justifyContent: 'space-between',
        alignItems: 'center',
        paddingHorizontal: 4,
        paddingBottom: 15,
        backgroundColor: 'transparent',
        zIndex: 10,
    },
    headerSubtitle: { color: '#64748b', fontSize: 14, fontWeight: '600' },
    actionButtons: { flexDirection: 'row', justifyContent: 'flex-end', gap: 10 },
    iconBtn: {

TypeScript
import React, { useState } from "react";
import {
  View,
  Text,
  StyleSheet,
  ScrollView,
  Pressable,
  SafeAreaView
} from "react-native";
// Importamos los componentes de la carpeta de tu amigo
import RoomItem from "../components/RoomItem";
import RoomsHeader from "../components/RoomsHeader";
import CreateRoomButton from "../components/CreateRoomButton";
import CreateRoomModal from "../components/CreateRoomModal";

export default function RoomsScreen({ navigation }: any) {
  const [showCreateModal, setShowCreateModal] = useState(false);

  // Datos mockeados de las salas
  const rooms = [
    {
      id: 1,
      name: "Cálculo I - Final",
      code: "CALC-7X9P",
      mode: "Supervivencia",
      members: 5,
      ranking: 2,
    },
    {
      id: 2,
      name: "Física II",
      code: "FIS2-A4B1",
      mode: "Equipos",
      members: 8,
      ranking: 3,
    },
  ];

  return (
    <SafeAreaView style={styles.container}>
      {/* Header de la sección de salas */}
      <RoomsHeader navigation={navigation} />

      <ScrollView contentContainerStyle={styles.content}>
        {/* Botón para abrir el modal de creación */}
        <CreateRoomButton onPress={() => setShowCreateModal(true)} />

        <Text style={styles.title}>MIS SALAS</Text>

        {/* Mapeo de las salas con la navegación corregida */}
        {rooms.map((room) => (
          <RoomItem
            key={room.id}
            room={room}
            onPress={() =>
              navigation.navigate("RoomDetail", { room }) // Navegación directa al detalle
            }
          />
        ))}
      </ScrollView>

      {/* Botón flotante (FAB) */}
      <Pressable 
        style={styles.fab} 
        onPress={() => setShowCreateModal(true)}
      >
        <Text style={styles.fabText}>+</Text>
      </Pressable>

      {/* Modal para crear salas nuevas */}
      <CreateRoomModal
        visible={showCreateModal}
        onClose={() => setShowCreateModal(false)}
      />
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: "#0f111a",
  },
  content: {
    padding: 16,
    paddingBottom: 120, // Espacio para que el FAB no tape la última card
  },
  title: {
    fontSize: 18,
    fontWeight: "bold",
    color: "#fff",
    marginBottom: 16,
    marginTop: 10,

import { View, Text } from 'react-native';

export default function TimerCard() { // El componente DEBE empezar con mayúscula
  const [time, setTime] = useState(0); // Línea 4: Si aquí falla, es por el import de arriba
  // ... resto del código
}
3. El problema de los "Shadows"
El aviso de "shadow*" style props are deprecated es porque están usando propiedades de sombra viejas. No rompe la app, pero ensucia la consola. Habría que cambiarlas por boxShadow más adelante, pero ahora no es la prioridad.  

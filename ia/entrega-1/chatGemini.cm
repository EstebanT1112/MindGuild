TypeScript
export type RankingType = 'semanal' | 'racha' | 'academico' | 'jefes';

export interface RankingEntry {
  user_id: string;
  username: string;
  avatar_url: string | null;
  value: number;
  position: number;
}
2. El Servicio (Lógica de base de datos)
Creá backend/src/modules/ranking/ranking.service.ts. Aquí es donde hacemos los SELECT y los JOIN con la tabla profiles que ya tenés en Supabase.  
MD
+ 1

TypeScript
import { supabase } from '../../common/config/supabase'; // Ajustá según tu config de supabase
import { RankingType, RankingEntry } from './ranking.types';

export const getGlobalRanking = async (type: RankingType, week_year: string): Promise<RankingEntry[]> => {
  let query;

  if (type === 'racha') {
    // Para racha usamos la tabla profiles directamente
    query = supabase
      .from('profiles')
      .select('id, username, avatar_url, streak_days')
      .order('streak_days', { ascending: false });
  } else {
    // Para los demás usamos user_weekly_stats + join con profiles
    const columnMap = {
      semanal: 'total_minutes',
      academico: 'academic_score',
      jefes: 'bosses_count'
    };

    query = supabase
      .from('user_weekly_stats')
      .select(`
        total_minutes,
        academic_score,
        bosses_count,
        profiles (id, username, avatar_url)
      `)
      .eq('week_year', week_year)
      .order(columnMap[type], { ascending: false });
  }

  const { data, error } = await query.limit(50);

  if (error) throw error;

  // Formateamos para que el front reciba siempre la misma estructura
  return data.map((item: any, index: number) => {
    const profile = item.profiles || item; // Maneja el join o la tabla directa
    return {
      user_id: profile.id,
      username: profile.username,
      avatar_url: profile.avatar_url,
      value: type === 'racha' ? item.streak_days : item[type === 'semanal' ? 'total_minutes' : type === 'academico' ? 'academic_score' : 'bosses_count'],
      position: index + 1
    };
  });
};
3. El Controlador (El que recibe el pedido)
Creá backend/src/modules/ranking/ranking.controller.ts.  
MD

TypeScript
import { Request, Response } from 'express';
import * as rankingService from './ranking.service';
import { RankingType } from './ranking.types';

export const getRanking = async (req: Request, res: Response) => {
  try {
    const type = (req.query.type as RankingType) || 'semanal';
    const week_year = (req.query.week_year as string) || '2026-19'; // Debería venir del front

    const data = await rankingService.getGlobalRanking(type, week_year);
    res.json(data);
  } catch (error: any) {
    res.status(500).json({ error: error.message });
  }
};

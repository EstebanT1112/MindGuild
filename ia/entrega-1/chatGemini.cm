import React, { useState } from 'react';
import { 
  View, 
  Text, 
  StyleSheet, 
  ScrollView, 
  Pressable, 
  TextInput, 
  Modal, 
  SafeAreaView 
} from 'react-native';
import { ArrowLeft, UserPlus, Users, Trophy, Flame, X, Check, Search } from 'lucide-react-native';
import { colors, spacing, radius, typography } from '../../../theme/design-system';

export default function FriendsScreen() {
  const [showAddModal, setShowAddModal] = useState(false);
  const [searchUsername, setSearchUsername] = useState('');

  // Mock data basado en tu doc[cite: 10]
  const friends = [
    { id: 1, username: "kenji_tanaka", avatar: "K", streak: 7, weeklyHours: 15.5, level: 8, status: "online" },
    { id: 2, username: "yuki_yamamoto", avatar: "Y", streak: 5, weeklyHours: 12.3, level: 6, status: "online" },
  ];

  return (
    <SafeAreaView style={styles.safeArea}>
      <View style={styles.container}>
        {/* Header - RF-16[cite: 8] */}
        <View style={styles.header}>
          <Pressable style={styles.backButton}>
            <ArrowLeft color={colors.textSecondary} size={20} />
          </Pressable>
          <View style={styles.headerTitleContainer}>
            <Users color={colors.primary} size={20} />
            <Text style={styles.headerTitle}>AMIGOS</Text>
          </View>
          <View style={styles.coinBadge}>
            <View style={styles.coinIcon}><Text style={styles.coinText}>H</Text></View>
            <Text style={styles.coinAmount}>1,250</Text>
          </View>
        </View>

        <ScrollView style={styles.content} showsVerticalScrollIndicator={false}>
          <Text style={styles.sectionTitle}>MIS AMIGOS ({friends.length})</Text>
          
          {friends.map((friend) => (
            <View key={friend.id} style={styles.friendCard}>
              <View style={styles.friendHeader}>
                <View style={styles.avatarContainer}>
                  <View style={styles.avatar}>
                    <Text style={styles.avatarText}>{friend.avatar}</Text>
                  </View>
                  {friend.status === 'online' && <View style={styles.statusBadge} />}
                </View>
                
                <View style={styles.friendInfo}>
                  <Text style={styles.username}>@{friend.username}</Text>
                  <View style={styles.badgesRow}>
                    <View style={styles.levelBadge}>
                      <Text style={styles.levelText}>Nivel {friend.level}</Text>
                    </View>
                    {friend.streak >= 3 && (
                      <View style={styles.streakBadge}>
                        <Flame color="#fb923c" size={12} />
                        <Text style={styles.streakText}>{friend.streak}d</Text>
                      </View>
                    )}
                  </View>
                </View>
              </View>

              <View style={styles.statsRow}>
                <View style={styles.statItem}>
                  <Trophy color={colors.accent} size={16} />
                  <View>
                    <Text style={styles.statLabel}>Esta semana</Text>
                    <Text style={styles.statValue}>{friend.weeklyHours}h</Text>
                  </View>
                </View>
                <Pressable style={styles.viewProfileButton}>
                  <Text style={styles.viewProfileText}>Ver Perfil</Text>
                </Pressable>
              </View>
            </View>
          ))}
        </ScrollView>

        {/* Floating Action Button - RF-05[cite: 8] */}
        <Pressable 
          style={styles.fab} 
          onPress={() => setShowAddModal(true)}
        >
          <UserPlus color="white" size={24} />
        </Pressable>
      </View>
    </SafeAreaView>
  );
}


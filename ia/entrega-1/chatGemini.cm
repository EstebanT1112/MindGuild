import { Router } from 'express';
import { missionsController } from '../controller/missions.controller.js';

const router = Router();

/**
 * Ruta para obtener y asignar las misiones diarias del usuario.
 * GET /api/missions
 * * NOTA: Si tus compañeros ya usan un middleware global de autenticación (ej: requireAuth),
 * se lo podés pasar acá como segundo parámetro: router.get('/', requireAuth, missionsController.getUserMissions);
 */
router.get('/', missionsController.getUserMissions);

export default router;

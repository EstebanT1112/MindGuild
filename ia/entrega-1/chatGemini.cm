📊 SQL para el Ranking Semanal
Para que la pestaña "Semanal" en el celular no te aparezca vacía, necesitás cargar datos en la tabla que registra el tiempo de estudio. Usá este código en el SQL Editor de Supabase:

SQL
-- Primero asegurate de tener un usuario en la tabla profiles
-- (Si ya existe roro_utn, podés saltear este paso)
INSERT INTO profiles (user_id, username, streak_days)
VALUES ('65cd2839-038c-4484-a50d-ff338b31b3fa', 'roro_utn', 10)
ON CONFLICT (user_id) DO NOTHING;

-- Ahora agregamos datos al ranking semanal
-- El valor 'study_minutes' es lo que el backend suma para el ranking
INSERT INTO user_weekly_stats (user_id, study_minutes, week_number, year)
VALUES 
  ('65cd2839-038c-4484-a50d-ff338b31b3fa', 1530, 19, 2026), -- Vos con 25.5 horas
  ('532e3c92-5ad4-4209-80e8-95a0594de306', 1200, 19, 2026)  -- Otro usuario (utn)
ON CONFLICT (user_id, week_number, year) 
DO UPDATE SET study_minutes = EXCLUDED.study_minutes;

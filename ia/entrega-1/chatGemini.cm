  avatarText: { color: 'white', fontSize: 20, fontWeight: 'bold' },
  statusDot: { position: 'absolute', bottom: 0, right: 0, width: 14, height: 14, borderRadius: 7, borderWidth: 2, borderColor: colors.background },
  username: { color: colors.text, fontSize: 16, fontWeight: 'bold' },
  subText: { color: colors.textSecondary, fontSize: 12 },
  actionRow: { flexDirection: 'row', gap: 10 },
  actionButton: { flex: 1, height: 38, borderRadius: 10, flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 6 },
  actionButtonText: { color: 'white', fontWeight: 'bold', fontSize: 14 },
  badgeRow: { flexDirection: 'row', gap: 8, marginTop: 4 },
  levelBadge: { flexDirection: 'row', alignItems: 'center', backgroundColor: 'rgba(34, 197, 94, 0.15)', borderRadius: 12, paddingRight: 8 },
  miniLevelIcon: { width: 16, height: 16, borderRadius: 8, backgroundColor: colors.accent, alignItems: 'center', justifyContent: 'center' },
  miniLevelText: { fontSize: 10, fontWeight: 'bold', color: colors.background },

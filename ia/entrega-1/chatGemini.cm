VALUES ('11111111-1111-1111-1111-111111111111', 'Esteban Codelo', 'https://avatar.iran.liara.run/public/boy', 8)
ON CONFLICT (id) DO UPDATE SET streak_days = 8;

-- 3. Cargamos los datos semanales para las otras 3 pestañas (Minutos, Quizzes y Jefes)

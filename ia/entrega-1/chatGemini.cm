  levelText: { color: '#22c55e', fontSize: 11, fontWeight: 'bold' },
  streakBadge: { flexDirection: 'row', alignItems: 'center', gap: 4, backgroundColor: 'rgba(251, 146, 60, 0.2)', paddingHorizontal: 8, paddingVertical: 2, borderRadius: 10 },

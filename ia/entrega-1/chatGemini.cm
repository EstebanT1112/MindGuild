TypeScript
import React, { useState } from 'react';
import { 
  View, 
  Text, 
  StyleSheet, 
  SafeAreaView, 
  Pressable, 
  Image, 
  ScrollView 
} from 'react-native';
import { ArrowLeft, Edit2, Settings, Star, Trophy, Target, Zap } from 'lucide-react-native';
// Asegúrate de que el componente EditProfileModal esté en esta ruta
import EditProfileModal from '../components/EditProfileModal'; 

export default function ProfileScreen() {
  const [isEditModalVisible, setEditModalVisible] = useState(false);

  // Datos del usuario (Samurai Sensei)
  const userData = {
    name: "Samurai Sensei",
    username: "samurai_warrior",
    rating: "4.8/5.0",
    level: 5,
    // Usamos el placeholder por ahora
    photo: require('../../../assets/images/avatar-samurai.png'), 
  };

  return (
    <SafeAreaView style={styles.safeArea}>
      <View style={styles.container}>
        
        {/* HEADER CON BOTONES DE ACCIÓN */}
        <View style={styles.header}>
          <Pressable style={styles.backBtn}>
            <ArrowLeft color="#94a3b8" size={20} />
          </Pressable>
          
          <Text style={styles.headerTitle}>MI PERFIL</Text>
          
          <View style={styles.rightButtons}>
            {/* Botón Editar Perfil (Azul según tu imagen) */}
            <Pressable 
              style={[styles.actionBtn, styles.editBtnActive]} 
              onPress={() => setEditModalVisible(true)}
            >
              <Edit2 color="#3b82f6" size={18} />
            </Pressable>
            
            {/* Botón Configuración */}
            <Pressable style={styles.actionBtn}>
              <Settings color="#94a3b8" size={18} />
            </Pressable>
          </View>
        </View>

        <ScrollView showsVerticalScrollIndicator={false}>
          {/* INFO DE PERFIL Y AVATAR */}
          <View style={styles.profileInfo}>
            <View style={styles.avatarContainer}>
              <View style={styles.avatarRing}>
                <Image source={userData.photo} style={styles.avatarImg} />
              </View>
              {/* Badge de Nivel circular */}
              <View style={styles.levelBadge}>
                <Text style={styles.levelText}>{userData.level}</Text>
              </View>
            </View>

            <Text style={styles.nameText}>{userData.name}</Text>
            <Text style={styles.usernameText}>@{userData.username}</Text>
            
            {/* Rating con estrella dorada */}
            <View style={styles.ratingBadge}>
              <Star color="#facc15" size={16} fill="#facc15" />
              <Text style={styles.ratingText}>Rating: {userData.rating}</Text>
            </View>
          </View>

          {/* ESTADÍSTICAS DEL USUARIO */}
          <View style={styles.statsGrid}>
            <View style={styles.statCard}>
              <Trophy color="#facc15" size={24} />
              <Text style={styles.statNumber}>12</Text>
              <Text style={styles.statLabel}>Victorias</Text>
            </View>
            <View style={styles.statCard}>
              <Target color="#3b82f6" size={24} />
              <Text style={styles.statNumber}>85%</Text>
              <Text style={styles.statLabel}>Precisión</Text>
            </View>
            <View style={styles.statCard}>
              <Zap color="#22c55e" size={24} />
              <Text style={styles.statNumber}>7d</Text>
              <Text style={styles.statLabel}>Racha</Text>
            </View>
          </View>
        </ScrollView>

        {/* MODAL PARA EDITAR PERFIL */}
        <EditProfileModal 
          visible={isEditModalVisible} 
          onClose={() => setEditModalVisible(false)}
          currentData={{
            name: userData.name,
            username: userData.username,
            photo: userData.photo
          }}
        />
      </View>
    </SafeAreaView>
  );
}


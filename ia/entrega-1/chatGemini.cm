export const rankingsController = {
  async getRanking(req: Request, res: Response) {
    try {
      const type = (req.query.type as RankingType) || 'semanal';
      const roomId = req.query.roomId as string | undefined;
      
      // MODIFICACIÓN DE EMERGENCIA PARA DESARROLLO LOCAL:
      // Si no viene token (undefined), le clavamos un ID hardcodeado de tu base
      // Cambiá 'un-id-de-tu-tabla-users' por un UUID real que tengas en Supabase si querés ver datos posta
      const userId = (req as any).user?.id || '00000000-0000-0000-0000-000000000000';

      // COMENTÁ O BORRÁ estas líneas temporariamente para que no te rebote el 401:
      /*
      if (!userId) {
        return res.status(401).json({ error: 'Usuario no autenticado' });
      }
      */

      const result = await rankingsService.getRanking(type, userId, roomId);

      return res.status(200).json({
        success: true,
        data: result
      });

    } catch (error: any) {
      return res.status(400).json({
        success: false,
        error: error.message
      });
    }
  }
};

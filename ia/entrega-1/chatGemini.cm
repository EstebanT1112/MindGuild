Reemplazá todo el código de tu frontend/src/features/rooms/screens/BattleRoyaleScreen.tsx por este bloque completo y limpio:

TypeScript
import React, { useEffect, useState, useRef } from 'react';
import { ActivityIndicator, Alert, Pressable, ScrollView, StyleSheet, Text, View } from 'react-native';
import { useRoute } from '@react-navigation/native';
import { ChevronRight, Info, PlayCircle, Plus, Settings, Swords, Trash2 } from 'lucide-react-native';
import ScreenLayout from '../../../components/ui/ScreenLayout';
import { useAuthStore } from '../../../store/authStore';
import NewQuestionModal from '../components/NewQuestionModal';
import RoomInfoModal from '../components/RoomInfoModal';
import RoomRanking from '../components/RoomRanking';
import SessionConfigModal from '../components/SessionConfigModal';
import WeeklyQuizModal from '../components/WeeklyQuizModal';
import { fetchRoomDetails, type RoomDetails } from '../services/roomsService';

export default function BattleRoyaleScreen() {
    const route = useRoute<any>();
    const accessToken = useAuthStore(state => state.access_token);

    const [configVisible, setConfigVisible] = useState(false);
    const [infoVisible, setInfoVisible] = useState(false);
    const [questionVisible, setQuestionVisible] = useState(false);
    const [quizVisible, setQuizVisible] = useState(false);
    const [room, setRoom] = useState<RoomDetails | null>(null);
    const [loading, setLoading] = useState(true);

    // ⚡ ESTADOS PARA EL CRONÓMETRO DE BATTLE ROYALE
    const [isStudying, setIsStudying] = useState(false);
    const [secondsLeft, setSecondsLeft] = useState(25 * 60); // 25 minutos estándar
    const timerRef = useRef<any>(null);

    useEffect(() => {
        loadRoom();
    }, [route.params?.roomId, accessToken]);

    useEffect(() => {
        return () => {
            if (timerRef.current) clearInterval(timerRef.current);
        };
    }, []);

    const loadRoom = async () => {
        if (!accessToken || !route.params?.roomId) return;

        setLoading(true);
        try {
            const data = await fetchRoomDetails(accessToken, String(route.params.roomId));
            setRoom(data);
        } catch (error: any) {
            Alert.alert('Error de sala', error.message ?? 'No se pudo cargar la sala.');
        } finally {
            setLoading(false);
        }
    };

    // ⚡ CONTROLADOR DEL TIMER PÚRPURA
    const handleStartSession = () => {
        if (isStudying) {
            clearInterval(timerRef.current);
            setIsStudying(false);
            Alert.alert("Sesión pausada", "Cronómetro Battle Royale detenido.");
        } else {
            setIsStudying(true);
            timerRef.current = setInterval(() => {
                setSecondsLeft((prev) => {
                    if (prev <= 1) {
                        clearInterval(timerRef.current);
                        setIsStudying(false);
                        Alert.alert("¡Tiempo cumplido!", "Finalizó el bloque de combate.");
                        return 0;
                    }
                    return prev - 1;
                });
            }, 1000);
        }
    };

    const formatTime = (seconds: number) => {
        const mins = Math.floor(seconds / 60);
        const secs = seconds % 60;
        return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    };

    if (loading) {
        return (
            <ScreenLayout title="BATTLE ROYALE" type="rooms" icon={<Swords color="#a855f7" size={22} />}>
                <View style={styles.loadingState}>
                    <ActivityIndicator color="#a855f7" />
                    <Text style={styles.loadingText}>Cargando arena de estudio...</Text>
                </View>
            </ScreenLayout>
        );
    }

    return (
        <ScreenLayout
            title={room?.name ?? 'BATTLE ROYALE'}
            type="rooms"
            icon={<Swords color="#a855f7" size={22} />}
            rightAction={
                room ? (
                    <Pressable style={styles.infoBtn} onPress={() => setInfoVisible(true)}>
                        <Info color="#a855f7" size={20} />
                    </Pressable>
                ) : undefined
            }
        >
            <ScrollView showsVerticalScrollIndicator={false} contentContainerStyle={styles.scrollContent}>
                
                {/* Configuración de la sesión */}
                <Pressable style={styles.configCard} onPress={() => setConfigVisible(true)}>
                    <View style={styles.configIconBox}>
                        <Settings color="#a855f7" size={24} />
                    </View>
                    <View style={styles.configInfo}>
                        <Text style={styles.configTitle}>Configurar Sesion</Text>
                        <Text style={styles.configSub}>Pomodoro - 25min - Modo Estricto</Text>
                    </View>
                    <ChevronRight color="#4b5563" size={20} />
                </Pressable>

                {/* Sección del Cronómetro Gigante */}
                <View style={styles.timerSection}>
                    <View style={styles.timerCircle}>
                        <PlayCircle color="#a855f7" size={32} />
                        <Text style={styles.timerValue}>{formatTime(secondsLeft)}</Text>
                        <Text style={styles.timerCycles}>Fase de estudio</Text>
                    </View>
                </View>

                {/* Botón de Acción Principal */}
                <Pressable style={styles.startBtn} onPress={handleStartSession}>
                    <PlayCircle color="white" size={24} fill="white" />
                    <Text style={styles.startBtnText}>
                        {isStudying ? "FINALIZAR SESION" : "COMENZAR SESION"}
                    </Text>
                </Pressable>

                {/* Panel de Preguntas Propuestas */}
                <Text style={styles.sectionLabel}>PREGUNTAS PROPUESTAS</Text>
                <View style={styles.proposedCard}>
                    <View style={styles.proposedHeader}>
                        <Text style={styles.proposedText}>¿Cuál es la complejidad temporal de buscar en un árbol AVL en el peor caso?</Text>
                        <Pressable>
                            <Trash2 color="#ef4444" size={20} />
                        </Pressable>
                    </View>
                    <View style={styles.proposedFooter}>
                        <Text style={styles.authorText}>Por: Esteban</Text>
                        <View style={styles.badge}>
                            <Text style={styles.badgeText}>Estructuras</Text>
                        </View>
                    </View>
                </View>

                {/* Acciones de Trivia */}
                <View style={styles.actionRow}>
                    <Pressable style={styles.quizBtn} onPress={() => setQuizVisible(true)}>
                        <Swords color="white" size={20} />
                        <Text style={styles.quizBtnText}>Lanzar Quiz</Text>
                    </Pressable>

                    <Pressable style={styles.newQuestionBtn} onPress={() => setQuestionVisible(true)}>
                        <Plus color="white" size={20} />
                        <Text style={styles.newQuestionText}>Preguntar</Text>
                    </Pressable>
                </View>
                <Text style={styles.hintText}>Al finalizar la sesión se habilitará el Quiz semanal si hay preguntas suficientes.</Text>

                {/* Tabla de posiciones interna */}
                <Text style={styles.sectionLabel}>TOP GLADIADORES</Text>
                <RoomRanking roomId={room?.id} />

            </ScrollView>

            {/* Modales Tipados de Forma Segura */}
            <SessionConfigModal visible={configVisible} onClose={() => setConfigVisible(false)} />
            <NewQuestionModal visible={questionVisible} onClose={() => setQuestionVisible(false)} />
            <WeeklyQuizModal visible={quizVisible} onClose={() => setQuizVisible(false)} />
            
            {room && (
                <RoomInfoModal
                    visible={infoVisible}
                    room={room}
                    onClose={() => setInfoVisible(false)}
                />
            )}
        </ScreenLayout>
    );
}

const styles = StyleSheet.create({

    villageCard: { backgroundColor: '#1e293b', borderRadius: 28, padding: 20, marginBottom: 40, borderWidth: 1, borderColor: '#334155' },
    villageTitle: { color: 'white', fontSize: 18, fontWeight: 'bold', marginBottom: 15 },
    villageMainRow: { flexDirection: 'row', gap: 15, alignItems: 'center' },
    villageIconBox: { width: 100, height: 100, borderRadius: 20, borderWidth: 2, borderColor: '#22c55e', backgroundColor: '#0f172a', alignItems: 'center', justifyContent: 'center' },
    villageInfo: { flex: 1 },
    levelRow: { flexDirection: 'row', justifyContent: 'space-between', marginBottom: 6 },
    levelLabelText: { color: 'white', fontWeight: 'bold', fontSize: 14 },
    percentageText: { color: '#22c55e', fontWeight: 'bold', fontSize: 14 },

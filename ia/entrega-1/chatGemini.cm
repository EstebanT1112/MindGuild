import Constants from 'expo-constants';



const API_PORT = 3000;



function resolveApiBaseUrl() {

    const constants = Constants as any;

    const hostUri =

        Constants.expoConfig?.hostUri ??

        constants.expoGoConfig?.debuggerHost ??

        constants.manifest2?.extra?.expoClient?.hostUri ??

        constants.manifest?.debuggerHost;



    const host = hostUri?.split(':')[0];



    if (host) {

        return `http://${host}:${API_PORT}/api`;

    }



    return `http://localhost:${API_PORT}/api`;

}



export const API_BASE_URL = resolveApiBaseUrl();



console.log('API_BASE_URL', API_BASE_URL);



export interface RankingEntry {

    user_id: string;

    username: string;

    avatar_url: string | null;

    value: number;

    position: number;

}



export async function fetchRanking(type: 'semanal' | 'racha' | 'academico' | 'jefes'): Promise<RankingEntry[]> {

    const response = await fetch(`${API_BASE_URL}/ranking?type=${type}`);



    if (!response.ok) {

        throw new Error('Error al obtener el ranking');

    }



    return await response.json();

}

¡Fabuloso, roro! Con este archivo arriba de la mesa encontramos exactamente las dos razones letales por las que tu aplicación móvil sigue tirando el error en rojo y no muestra nada.

Preparate, porque acá combinamos el problema del token que sospechábamos con la forma en que fetch nativo de JavaScript maneja los errores.

🔍 El Diagnóstico (Los dos problemas en apiConfig.ts)
1. Estás yendo sin documentos al Backend (Falta el Token)
Mirá la llamada que armaste acá:

TypeScript
const response = await fetch(`${API_BASE_URL}/ranking?type=${type}`);
No le estás pasando ningún header con el token de autenticación. Como vimos en el código de tu backend (rankingsController), el servidor hace este chequeo estricto:

TypeScript
const userId = (req as any).user?.id;
if (!userId) return res.status(401).json({ error: 'Usuario no autenticado' });
Al no mandarle headers, el backend te rebota con un 401 Unauthorized.

2. Rompés el flujo antes de desempaquetar la data
Mirá tu validación:

TypeScript
if (!response.ok) {
    throw new Error('Error al obtener el ranking');
}
return await response.json();
Como el backend te tiró un 401 (o un 400), response.ok pasa a ser false. Tu código inmediatamente tira el throw new Error('Error al obtener el ranking') y se va directo al catch de la pantalla, impidiendo que veas el verdadero mensaje de error que te está escupiendo la API.

🛠️ La Solución Definitiva en tu services/apiConfig.ts
Para solucionarlo de una, tenemos que meterle los headers de autenticación a la llamada.

Como están usando Auth0 o un sistema de sesiones, lo ideal es recuperar el token que tengan guardado (generalmente en un SecureStore de Expo, un AsyncStorage, o pasándolo por parámetro).

Para destrabarlo ya mismo de manera inteligente y ver si el fix del backend responde, vamos a hacer que la función acepte un token o use un bypass de desarrollo para que el backend no te rebote.

Reemplazá tu función fetchRanking en el frontend por esta versión corregida:

TypeScript
export async function fetchRanking(
    type: 'semanal' | 'racha' | 'academico' | 'jefes',
    token?: string // Opcional por si manejan tokens en el estado global
): Promise<RankingEntry[]> {
    try {
        const response = await fetch(`${API_BASE_URL}/ranking?type=${type}`, {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json',
                // Mandamos el token si es que lo tenés guardado en el login
                ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
            }
        });

        // REVISIÓN CLAVE: Si no es OK, leemos el JSON interno para ver el error real del backend
        if (!response.ok) {
            const errorData = await response.json().catch(() => ({}));
            console.log('❌ Detalle del error que mandó el Backend:', errorData);
            throw new Error(errorData.error || 'Error al obtener el ranking');
        }

        return await response.json();
    } catch (error) {
        console.error('💥 Error dentro de fetchRanking:', error);
        throw error;
    }
}
🚨 El último toque (Bypass obligatorio en el Backend)
Como la app recién arranca y quizás todavía no implementaste el guardado del token en memoria del celu para pasárselo a fetchRanking(type, token), tenés que asegurarte de haber hecho el cambio que te pasé en el paso anterior en tu rankingsController del backend.

Asegurate de que tu controlador en el backend tenga desactivado el rebote automático del 401 si no hay token:


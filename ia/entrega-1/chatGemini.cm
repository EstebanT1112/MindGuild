import React, { useState } from 'react';
import { View, Text, StyleSheet, ScrollView, Pressable, SafeAreaView } from 'react-native';
import { ArrowLeft, UserPlus, Users, Trophy, Flame, X, Check } from 'lucide-react-native';
import { colors, spacing, radius } from '../../../theme/design-system';

export default function FriendsScreen() {
  const [showAddModal, setShowAddModal] = useState(false);

  const pendingRequests = [
    { id: 1, username: "maria_lopez", avatar: "M", mutualFriends: 2 },
    { id: 2, username: "carlos_ruiz", avatar: "C", mutualFriends: 1 },
  ];

  const friends = [
    { id: 1, username: "kenji_tanaka", avatar: "K", streak: 7, weeklyHours: 15.5, level: 8, status: "online" },
    { id: 2, username: "yuki_yamamoto", avatar: "Y", streak: 5, weeklyHours: 12.3, level: 6, status: "online" },
    { id: 3, username: "akira_sato", avatar: "A", streak: 3, weeklyHours: 8.7, level: 5, status: "offline" },
    { id: 4, username: "hiro_nakamura", avatar: "H", streak: 0, weeklyHours: 6.2, level: 4, status: "offline" },
  ];

  return (
    <SafeAreaView style={styles.safeArea}>
      <View style={styles.container}>
        {/* Header con estética Figma */}
        <View style={styles.header}>
          <Pressable style={styles.backButton}>
            <ArrowLeft color={colors.textSecondary} size={20} />
          </Pressable>
          <View style={styles.headerTitleRow}>
            <Users color={colors.primary} size={20} />
            <Text style={styles.headerText}>AMIGOS</Text>
          </View>
          <View style={styles.currencyBadge}>
            <View style={styles.hCoin}><Text style={styles.hText}>H</Text></View>
            <Text style={styles.coinAmount}>1,250</Text>
          </View>
        </View>

        <ScrollView showsVerticalScrollIndicator={false} style={styles.scroll}>
          {/* Solicitudes Pendientes con el degradado azulado */}
          <Text style={styles.sectionTitle}>SOLICITUDES PENDIENTES ({pendingRequests.length})</Text>
          {pendingRequests.map(req => (
            <View key={req.id} style={styles.requestCard}>
              <View style={styles.userRow}>
                <View style={[styles.avatar, { backgroundColor: '#3b82f6' }]}>
                  <Text style={styles.avatarLetter}>{req.avatar}</Text>
                </View>
                <View>
                  <Text style={styles.userNameText}>@{req.username}</Text>
                  <Text style={styles.mutualText}>{req.mutualFriends} amigos en común</Text>
                </View>
              </View>
              <View style={styles.requestActions}>
                <Pressable style={[styles.btnAction, { backgroundColor: colors.primary }]}>
                  <Check color="white" size={16} /><Text style={styles.btnText}>Aceptar</Text>
                </Pressable>
                <Pressable style={[styles.btnAction, styles.btnReject]}>
                  <X color={colors.textSecondary} size={16} /><Text style={styles.btnText}>Rechazar</Text>
                </Pressable>
              </View>
            </View>
          ))}

          {/* Lista de Amigos */}
          <View style={styles.listHeader}>
            <Text style={styles.sectionTitle}>MIS AMIGOS ({friends.length})</Text>
            <Text style={styles.orderBtn}>Ordenar</Text>
          </View>

          {friends.map(friend => (
            <View key={friend.id} style={styles.friendCard}>
              <View style={styles.userRow}>
                <View>
                  <View style={[styles.avatar, { backgroundColor: colors.primary }]}>
                    <Text style={styles.avatarLetter}>{friend.avatar}</Text>
                  </View>
                  <View style={[styles.statusIndicator, { backgroundColor: friend.status === 'online' ? colors.primary : '#4b5563' }]} />
                </View>
                <View style={styles.friendInfo}>
                  <Text style={styles.userNameText}>@{friend.username}</Text>
                  <View style={styles.badgeContainer}>
                    <View style={styles.levelBadge}>
                      <View style={styles.levelCircle}><Text style={styles.levelNum}>{friend.level}</Text></View>
                      <Text style={styles.levelText}>Nivel {friend.level}</Text>
                    </View>
                    {friend.streak > 0 && (
                      <View style={styles.streakBadge}>
                        <Flame color="#fb923c" size={12} />
                        <Text style={styles.streakText}>{friend.streak}d</Text>
                      </View>
                    )}
                  </View>
                </View>
              </View>
              
              <View style={styles.statsRow}>
                <View style={styles.statItem}>
                  <Trophy color={colors.accent} size={16} />
                  <View>
                    <Text style={styles.statLabel}>Esta semana</Text>
                    <Text style={styles.statValue}>{friend.weeklyHours}h</Text>
                  </View>
                </View>
                <Pressable style={styles.profileBtn}><Text style={styles.profileBtnText}>Ver Perfil</Text></Pressable>
              </View>
            </View>
          ))}
        </ScrollView>

        {/* Botón flotante verde neón */}
        <Pressable style={styles.fab} onPress={() => setShowAddModal(true)}>
          <UserPlus color="white" size={24} />
        </Pressable>
      </View>
    </SafeAreaView>
  );
}


1. El Repositorio (Consultas a DB)
Creá backend/src/modules/ranking/ranking.repository.ts. Este archivo se encarga exclusivamente de hablar con Supabase.  
MD
+ 1

TypeScript
import { supabase } from '../../common/config/supabase';
import { RankingType } from './ranking.types';

export const getRankingData = async (type: RankingType, week_year: string) => {
  if (type === 'racha') {
    return await supabase
      .from('profiles')
      .select('id, username, avatar_url, streak_days')
      .order('streak_days', { ascending: false })
      .limit(50);
  }

  const columnMap = {
    semanal: 'total_minutes',
    academico: 'academic_score',
    jefes: 'bosses_count'
  };

  return await supabase
    .from('user_weekly_stats')
    .select(`
      total_minutes,
      academic_score,
      bosses_count,
      profiles (id, username, avatar_url)
    `)
    .eq('week_year', week_year)
    .order(columnMap[type], { ascending: false })
    .limit(50);
};
2. El Servicio (Lógica de Negocio)
Creá backend/src/modules/ranking/ranking.service.ts. Este llama al repository y formatea los datos para el front.  
MD

TypeScript
import * as rankingRepository from './ranking.repository';
import { RankingType, RankingEntry } from './ranking.types';

export const getGlobalRanking = async (type: RankingType, week_year: string): Promise<RankingEntry[]> => {
  const { data, error } = await rankingRepository.getRankingData(type, week_year);

  if (error) throw error;

  return data.map((item: any, index: number) => {
    const profile = item.profiles || item;
    return {
      user_id: profile.id,
      username: profile.username,
      avatar_url: profile.avatar_url,
      value: type === 'racha' ? item.streak_days : 
             type === 'semanal' ? item.total_minutes : 
             type === 'academico' ? item.academic_score : item.bosses_count,
      position: index + 1
    };
  });
};

TypeScript
import { pool } from '../../../common/config/db.js';

// Función para calcular la semana actual (IDéntica a la que usamos en Study)
const getWeekYear = (): string => {
  const now = new Date();
  const oneJan = new Date(now.getFullYear(), 0, 1);
  const numberOfDays = Math.floor((now.getTime() - oneJan.getTime()) / (24 * 60 * 60 * 1000));
  const weekNumber = Math.ceil((now.getDay() + 1 + numberOfDays) / 7);
  return `${weekNumber}-${now.getFullYear()}`;
};

export const rankingsRepository = {
  // RF-11 Prompt 1: Validar si el usuario es miembro activo de la sala
  async getMemberStatus(roomId: string, userId: string) {
    const { rows } = await pool.query(
      `SELECT is_active FROM room_members WHERE room_id = $1 AND user_id = $2 LIMIT 1`,
      [roomId, userId]
    );
    return rows[0] || null;
  },

  // RF-11 Prompt 2: Obtener estadísticas de la semana actual con datos de perfil
  async getWeeklyRoomStats(roomId: string) {
    const weekYear = getWeekYear();
    const { rows } = await pool.query(
      `
      SELECT 
        ru.user_id, 
        ru.total_minutes,
        p.username,
        p.avatar_url
      FROM room_user_weekly_stats ru
      INNER JOIN profiles p ON ru.user_id = p.id
      WHERE ru.room_id = $1 AND ru.week_year = $2
      ORDER BY ru.total_minutes DESC;
      `,
      [roomId, weekYear]
    );

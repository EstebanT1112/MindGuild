    },
    avatarImage: { width: '100%', height: '100%', borderRadius: 55 },
    levelBadge: {
        position: 'absolute',
        bottom: -5,
        right: -5,
        backgroundColor: '#22c55e',
        borderRadius: 12,
        paddingHorizontal: 8,
        paddingVertical: 2,
        borderWidth: 2,
        borderColor: '#0f172a',
    },
    levelText: { color: 'white', fontSize: 12, fontWeight: 'bold' },
    userName: { color: 'white', fontSize: 24, fontWeight: 'bold' },
    userTag: { color: '#64748b', fontSize: 14, marginBottom: 8 },
    bioText: { color: '#94a3b8', fontSize: 14, textAlign: 'center', paddingHorizontal: 20, marginBottom: 10 },
    ratingRow: { flexDirection: 'row', alignItems: 'center', gap: 5 },
    ratingText: { color: '#facc15', fontSize: 14, fontWeight: '600' },
    
    statsGrid: { flexDirection: 'row', flexWrap: 'wrap', gap: 12, justifyContent: 'center', marginBottom: 20 },
    medalsSection: { backgroundColor: '#1e293b', borderRadius: 28, padding: 20, marginBottom: 20, borderWidth: 1, borderColor: '#334155' },
    sectionHeaderRow: { flexDirection: 'row', alignItems: 'center', gap: 8, marginBottom: 15 },
    sectionTitle: { color: 'white', fontSize: 18, fontWeight: 'bold' },
    medalsGrid: { flexDirection: 'row', flexWrap: 'wrap', gap: 12, justifyContent: 'center' },
    medalCard: {
        width: '30%',
        backgroundColor: '#0f172a',
        padding: 15,
        borderRadius: 20,
        alignItems: 'center',
        gap: 8,
        borderWidth: 1,
        borderColor: '#334155',
    },

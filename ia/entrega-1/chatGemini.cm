import { studyRepository } from '../repository/study.repository.js';



export const studyService = {

  /**

   * Registra el impacto de una sesión aprobada en todas las estadísticas.

   * Coordina los 3 prompts del RF-09.

   */

  async registerStudyTime(sessionId: string) {

    // 1. VALIDACIÓN (Prompt 1)

    const validatedData = await this.validateSessionForImpact(sessionId);



    // 2. ACTUALIZACIÓN GLOBAL (Prompt 2)

    const newTotalAccumulated = await studyRepository.updateUserTotalMinutes(

      validatedData.userId,

      validatedData.durationMinutes

    );



    // 3. ACTUALIZACIÓN SEMANAL (Prompt 3)

    const { weekYear } = await studyRepository.updateWeeklyStats(

      validatedData.userId,

      validatedData.roomId,

      validatedData.durationMinutes

    );



    return {

      success: true,

      message: "Tiempo de estudio impactado correctamente en rankings y perfil",

      data: {

        userId: validatedData.userId,

        minutesAdded: validatedData.durationMinutes,

        currentWeek: weekYear,

        newTotalHistorical: newTotalAccumulated

      }

    };

  },



  /**

   * Filtra si la sesión cumple los requisitos mínimos para sumar tiempo.

   */

  async validateSessionForImpact(sessionId: string) {

    const session = await studyRepository.getSessionForValidation(sessionId);



    if (!session) throw new Error('Sesión no encontrada');



    // Reglas del requerimiento

    if (session.status !== 'completed') throw new Error('Sesión incompleta');

    if (!session.valid) throw new Error('Sesión marcada como no válida');

    if (session.approval_status !== 'approved') throw new Error('Sesión no aprobada');

    if (session.duration_minutes < 60) throw new Error('Mínimo 60 minutos requeridos');



    return {

      userId: session.user_id,

      roomId: session.room_id,

      durationMinutes: session.duration_minutes

    };

  }

};

¡Dale, roro! Vamos a blindar ese código para que nadie te haga trampa con los minutos.

Le agregué una marca de seguridad para que una sesión no se pueda cobrar dos veces y una validación para que solo el dueño de la sesión pueda impactar su tiempo.

🛠️ Código de studyService Actualizado
Reemplazá tu archivo con este código:

TypeScript
import { studyRepository } from '../repository/study.repository.js';

export const studyService = {
  /**
   * Registra el impacto de una sesión aprobada en todas las estadísticas.
   * Coordina los 3 prompts del RF-09.
   */
  async registerStudyTime(sessionId: string, currentUserId: string) {
    // 1. VALIDACIÓN (Prompt 1 + Seguridad)
    const validatedData = await this.validateSessionForImpact(sessionId, currentUserId);

    // 2. ACTUALIZACIÓN GLOBAL (Prompt 2)
    const newTotalAccumulated = await studyRepository.updateUserTotalMinutes(
      validatedData.userId,
      validatedData.durationMinutes
    );

    // 3. ACTUALIZACIÓN SEMANAL (Prompt 3)
    const { weekYear } = await studyRepository.updateWeeklyStats(
      validatedData.userId,
      validatedData.roomId,
      validatedData.durationMinutes
    );

    // 4. MARCAR COMO PROCESADA (Seguridad Antifraude)
    await studyRepository.markSessionAsImpacted(sessionId);

    return {
      success: true,
      message: "Tiempo de estudio impactado correctamente en rankings y perfil",
      data: {
        userId: validatedData.userId,
        minutesAdded: validatedData.durationMinutes,
        currentWeek: weekYear,
        newTotalHistorical: newTotalAccumulated
      }
    };
  },

  /**
   * Filtra si la sesión cumple los requisitos mínimos para sumar tiempo.
   */
  async validateSessionForImpact(sessionId: string, currentUserId: string) {
    const session = await studyRepository.getSessionForValidation(sessionId);

    if (!session) throw new Error('Sesión no encontrada');

    // SEGURIDAD: Validar que el que pide el impacto es el dueño de la sesión
    if (session.user_id !== currentUserId) {
      throw new Error('No tenés permiso para acreditar esta sesión');
    }

    // SEGURIDAD: Validar que no se haya cobrado ya
    if (session.is_impacted) {
      throw new Error('Esta sesión ya fue impactada anteriormente');
    }

    // REGLAS DEL REQUERIMIENTO
    if (session.status !== 'completed') throw new Error('Sesión incompleta');
    if (!session.valid) throw new Error('Sesión marcada como no válida');
    if (session.approval_status !== 'approved') throw new Error('Sesión no aprobada');
    if (session.duration_minutes < 60) throw new Error('Mínimo 60 minutos requeridos');

    return {
      userId: session.user_id,
      roomId: session.room_id,
      durationMinutes: session.duration_minutes
    };
  }
};
📢 Notas importantes para que no te tire error:
En el Controller: Ahora tenés que pasarle el userId del usuario logueado a la función. Sería algo como: studyService.registerStudyTime(sessionId, req.user.id).

En el Repository: Vas a tener que agregar el método markSessionAsImpacted(sessionId) que simplemente haga un update en la tabla study_sessions poniendo la columna is_impacted en true.

En Supabase: Asegurate de agregar la columna is_impacted (tipo boolean, default false) a tu tabla de sesiones.

¡Con esto ya tenés un sistema de nivel profesional! Nadie va a poder sumar puntos que no le corresponden ni repetir la misma sesión mil veces. 🚀


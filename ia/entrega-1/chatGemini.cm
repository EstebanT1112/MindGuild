});
3. WeeklyQuizModal.tsx
La lógica del quiz con barra de progreso.

TypeScript
import React, { useState } from 'react';
import { Modal, View, Text, StyleSheet, Pressable, TextInput } from 'react-native';
import { X } from 'lucide-react-native';

export default function WeeklyQuizModal({ visible, onClose }: { visible: boolean; onClose: () => void }) {
    const [step, setStep] = useState(1);
    const totalSteps = 2;

    return (
        <Modal visible={visible} animationType="fade" transparent>
            <View style={styles.overlay}>
                <View style={styles.content}>
                    <View style={styles.header}>
                        <Text style={styles.title}>Quiz Semanal</Text>
                        <Pressable onPress={onClose} style={styles.closeBtn}><X color="white" size={20} /></Pressable>
                    </View>

                    <View style={styles.progressRow}>
                        <Text style={styles.stepText}>Pregunta {step} de {totalSteps}</Text>
                        <View style={styles.dots}>
                            <View style={[styles.dot, step >= 1 && styles.dotActive]} />
                            <View style={[styles.dot, step >= 2 && styles.dotActive]} />
                        </View>
                    </View>

                    <View style={styles.quizCard}>
                        <Text style={styles.questionText}>
                            {step === 1 ? "¿Cuál es la derivada de x²?" : "Explica el teorema fundamental del cálculo"}
                        </Text>

                        {step === 1 ? (
                            <View style={styles.options}>
                                {['x', '2x', 'x²', '2'].map(opt => (
                                    <Pressable key={opt} style={styles.optionBtn}>
                                        <View style={styles.radio} />
                                        <Text style={styles.optLabel}>{opt}</Text>
                                    </Pressable>
                                ))}
                            </View>
                        ) : (
                            <TextInput style={styles.textArea} placeholder="Escribe tu respuesta aquí..." placeholderTextColor="#4b5563" multiline />
                        )}
                    </View>

                    <Pressable 
                        style={[styles.nextBtn, step === 2 && styles.finishBtn]} 
                        onPress={() => step < totalSteps ? setStep(step + 1) : onClose()}
                    >
                        <Text style={styles.nextText}>{step === 2 ? "Finalizar Quiz" : "Siguiente"}</Text>
                    </Pressable>
                </View>
            </View>
        </Modal>
    );
}

const styles = StyleSheet.create({
    overlay: { flex: 1, backgroundColor: 'rgba(0,0,0,0.95)', justifyContent: 'center', padding: 20 },
    content: { backgroundColor: '#0f172a', borderRadius: 32, padding: 25, borderWidth: 1, borderColor: '#a855f744' },
    header: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: 20 },
    title: { color: 'white', fontSize: 22, fontWeight: 'bold' },
    closeBtn: { width: 32, height: 32, borderRadius: 16, backgroundColor: '#1e293b', alignItems: 'center', justifyContent: 'center' },
    progressRow: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: 20 },
    stepText: { color: '#64748b', fontSize: 14 },
    dots: { flexDirection: 'row', gap: 8 },
    dot: { width: 8, height: 8, borderRadius: 4, backgroundColor: '#334155' },
    dotActive: { backgroundColor: '#a855f7' },
    quizCard: { backgroundColor: '#1e293b', borderRadius: 24, padding: 20, borderWidth: 1, borderColor: '#a855f744', minHeight: 300 },
    questionText: { color: 'white', fontSize: 18, fontWeight: 'bold', marginBottom: 20 },
    optionBtn: { flexDirection: 'row', alignItems: 'center', gap: 15, backgroundColor: '#0f172a', padding: 15, borderRadius: 15, marginBottom: 10, borderWidth: 1, borderColor: '#334155' },
    radio: { width: 22, height: 22, borderRadius: 11, borderWidth: 2, borderColor: '#4b5563' },
    optLabel: { color: 'white', fontSize: 16 },
    textArea: { backgroundColor: '#0f172a', color: 'white', borderRadius: 15, padding: 15, height: 150, textAlignVertical: 'top' },
    nextBtn: { backgroundColor: '#581c87', padding: 20, borderRadius: 20, alignItems: 'center', marginTop: 30 },
    finishBtn: { backgroundColor: '#22c55e' },
    nextText: { color: 'white', fontWeight: 'bold', fontSize: 18 }
});
🚀 ¿Qué cambió?
Identidad Visual: Pasamos de verde a violeta (#a855f7) en el timer, botones principales y badges.

Nuevas Secciones: Agregamos los bloques de Quiz Semanal y Agregar Preguntas.

Interactividad: El WeeklyQuizModal tiene lógica de pasos (Dots) y el NewQuestionModal permite alternar entre Multiple Choice y Desarrollo, tal cual el Figma.

¿Cómo lo ves ahora, Roro? Si pegás esto ya tenés las dos modalidades de salas funcionando al pelo. ¡Mandale con los comandos!

banca q rama

Para este nuevo desarrollo de la Battle Royale, lo mejor es que abras una rama nueva para mantener el código organizado y que los PRs no se pisen.

Como ya terminaste lo de Salas Comunes y lo de Perfil, esta nueva funcionalidad debería ir en una rama específica de "Competencia" o "Modos de Juego".

🚀 Comandos para la nueva rama
Ejecutá esto en tu terminal para empezar de cero con la Battle Royale:

Bash
# 1. Volvé a tu rama principal para salir de la de Perfil
git checkout main
git pull origin main

# 2. Creá la rama para el modo Battle Royale
git checkout -b feature/battle-royale-mode
📝 Título y Comentario para el PR (Español)
Cuando termines de subir los archivos que te pasé (BattleRoyaleScreen, NewQuestionModal y WeeklyQuizModal), usá esto:

Título:
feat: implementación integral del modo Battle Royale y sistema de Quiz Semanal

Comentario:
Implementación desde cero de la interfaz y lógica para las salas de tipo Battle Royale, diferenciándolas de las salas comunes mediante una nueva identidad visual y mecánicas de gamificación.

Interfaz Neón/Violeta: Adaptación total de la UI (Timer, botones y estados) al estilo Battle Royale del Figma.

Sistema de Quiz Semanal: Creación del WeeklyQuizModal con soporte para preguntas de opción múltiple y desarrollo, incluyendo barra de progreso.

Gestión de Preguntas: Implementación del NewQuestionModal para que los usuarios propongan contenido, permitiendo elegir el tipo de respuesta.

Sección de Propuestas: Añadido el feed de "Mis Preguntas Propuestas" con estados de votación y eliminación.


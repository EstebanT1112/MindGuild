TypeScript
import React from 'react';
import { View, Text, StyleSheet } from 'react-native';
import { colors, spacing, radius } from '../../../theme/design-system';

export default function MissionCard({ mission }: any) {
  return (
    <View style={styles.card}>
      <Text style={styles.text}>{mission.title}</Text>
      <Text style={styles.progress}>{mission.progress}/{mission.target}</Text>
    </View>
  );
}

const styles = StyleSheet.create({
  card: { backgroundColor: colors.surface, padding: spacing.md, borderRadius: radius.md, marginBottom: spacing.sm },
  text: { color: colors.text, fontWeight: 'bold' },
  progress: { color: colors.primary, fontSize: 12 }
});

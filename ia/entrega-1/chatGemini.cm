  streakLabel: { color: '#fb923c', fontSize: 11, fontWeight: 'bold' },
  statsInfoRow: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', backgroundColor: 'rgba(0,0,0,0.2)', padding: 12, borderRadius: 12 },
  statDetail: { flexDirection: 'row', alignItems: 'center', gap: 10 },

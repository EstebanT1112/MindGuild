  ('11111111-1111-1111-1111-111111111111', 'auth0|mock_esteban_456', 'Esteban Codelo', 'https://avatar.iran.liara.run/public/boy', 8)
ON CONFLICT (id) DO UPDATE SET 
  streak_days = EXCLUDED.streak_days,
  auth0_user_id = EXCLUDED.auth0_user_id;


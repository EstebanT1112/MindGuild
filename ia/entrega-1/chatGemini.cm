import { supabase } from '../../../common/config/supabase.js';

import type { RankingType } from '../types/ranking.types.js';



export const getRankingData = async (type: RankingType, week_year: string) => {

  if (type === 'racha') {

    return await supabase

      .from('profiles')

      .select('id, username, avatar_url, streak_days')

      .order('streak_days', { ascending: false })

      .limit(50);

  }



  const columnMap = {

    semanal: 'total_minutes',

    academico: 'academic_score',

    jefes: 'bosses_count'

  };



  return await supabase

    .from('user_weekly_stats')

    .select(`

      total_minutes,

      academic_score,

      bosses_count,

      profiles (id, username, avatar_url)

    `)

    .eq('week_year', week_year)

    .order(columnMap[type as keyof typeof columnMap], { ascending: false })

    .limit(50);

};

¡Opa! Buen punto ahí, roro. Ese código que ya tenías está usando la librería de Supabase directamente. Como ahora en el resto del proyecto (Study, History) estamos usando pool de PostgreSQL para tener más control, lo ideal es unificar todo.

Como sos el Lead, no podemos tener un módulo con Supabase y otro con pg, porque se vuelve un lío mantenerlo. Vamos a "traducir" ese código a la nueva arquitectura pero manteniendo las funcionalidades de racha, académico y jefes que ya tenías pensadas.

🛠️ Rankings Repository (Actualizado y Unificado)
Cambiá el contenido de backend/src/modules/rankings/repository/rankings.repository.ts por este. He adaptado tu lógica de racha y tipos al formato de pool:

TypeScript
import { pool } from '../../../common/config/db.js';

export const rankingsRepository = {
  // RF-11: Validar si el usuario es miembro activo de la sala
  async getMemberStatus(roomId: string, userId: string) {
    const { rows } = await pool.query(
      `SELECT is_active FROM room_members WHERE room_id = $1 AND user_id = $2 LIMIT 1`,
      [roomId, userId]
    );
    return rows[0] || null;
  },

  // Tu lógica anterior adaptada a SQL puro y Postgres Pool
  async getRankingData(type: string, weekYear: string, roomId?: string) {
    // 1. Caso de RACHA (Viene de la tabla profiles)
    if (type === 'racha') {
      const { rows } = await pool.query(
        `SELECT id, username, avatar_url, streak_days 
         FROM profiles 
         ORDER BY streak_days DESC 
         LIMIT 50`
      );
      return rows;
    }

    // 2. Casos Semanal, Académico o Jefes (Vienen de estadísticas semanales)
    // Mapeamos el tipo a la columna correspondiente
    const columnMap: Record<string, string> = {
      semanal: 'total_minutes',
      academico: 'academic_score',
      jefes: 'bosses_count'
    };

    const column = columnMap[type] || 'total_minutes';

    // Si pasamos roomId, filtramos por sala (Ranking de Sala)
    // Si no, es un ranking Global
    const query = `
      SELECT 
        ru.total_minutes,
        ru.academic_score,
        ru.bosses_count,
        p.id, 
        p.username, 
        p.avatar_url
      FROM ${roomId ? 'room_user_weekly_stats ru' : 'user_weekly_stats ru'}
      INNER JOIN profiles p ON ru.user_id = p.id
      WHERE ru.week_year = $1 
      ${roomId ? 'AND ru.room_id = $2' : ''}
      ORDER BY ru.${column} DESC
      LIMIT 50;
    `;

    const params = roomId ? [weekYear, roomId] : [weekYear];
    const { rows } = await pool.query(query, params);
    return rows;
  }
};
🧐 ¿Qué mejoras metimos como Lead?
Unificación: Ahora todo usa pool, eliminando la dependencia de @supabase/supabase-js en este módulo.

Flexibilidad: Agregué el parámetro roomId. Si lo mandás, te trae el ranking de la sala (lo que pide el RF-11). Si no lo mandás, te trae el ranking global (lo que tenías antes). ¡Dos pájaros de un tiro!

Seguridad de SQL: Usamos parámetros ($1, $2) para evitar que algún gracioso intente un SQL Injection.

🚀 ¿Cómo seguimos?
Ahora que el Repository entiende tanto tus ideas previas como el nuevo requerimiento de salas, ¿armamos el Service para que maneje estos tipos (racha, semanal, etc.)?

Pasame el archivo de Types (ranking.types.ts) si lo tenés a mano para que los nombres coincidan perfecto. ¡Vamos que el RF-11 sale con fritas! 🏎️

export type RankingType = 'semanal' | 'racha' | 'academico' | 'jefes';



export interface RankingEntry {

  user_id: string;

  username: string;

  avatar_url: string | null;

  value: number;

  position: number;

}

Perfecto, roro, con esos tipos ya tenemos el contrato de datos definido. Como sos el Lead, mantener los archivos de types actualizados es clave para que a tus compañeros no les explote el TypeScript en el frontend.

Vamos a unificar el Service. Este servicio va a ser el "cerebro" que decida qué datos traer del repositorio (si racha, semanal, etc.) y les va a dar el formato final de RankingEntry que definiste vos, agregando la posición (1º, 2º, 3º).

🛠️ backend/src/modules/rankings/service/rankings.service.ts
Copiá este código. Fijate cómo adaptamos tu lógica de tipos para que el ranking funcione tanto para Salas como para el Global:

TypeScript
import { rankingsRepository } from '../repository/rankings.repository.js';
import type { RankingType, RankingEntry } from '../types/ranking.types.js';

export const rankingsService = {
  /**
   * Obtiene el ranking solicitado (Semanal, Racha, Académico o Jefes).
   * Si se provee roomId, filtra por los miembros de esa sala (RF-11).
   */
  async getRanking(type: RankingType, userId: string, roomId?: string) {
    // 1. Si es un ranking de sala, validamos que el usuario pertenezca (Seguridad Lead)
    if (roomId) {
      const member = await rankingsRepository.getMemberStatus(roomId, userId);
      if (!member || !member.is_active) {
        throw new Error('No tienes acceso al ranking de esta sala');
      }
    }

    // 2. Calculamos la semana actual para las consultas
    const weekYear = this.getCurrentWeekYear();

    // 3. Pedimos los datos al repositorio (el que unificamos recién)
    const rawData = await rankingsRepository.getRankingData(type, weekYear, roomId);

    // 4. Formateamos a RankingEntry (Tu interfaz)
    const formattedRanking: RankingEntry[] = rawData.map((item, index) => {
      // Determinamos qué valor mostrar según el tipo
      let value = 0;
      if (type === 'racha') value = item.streak_days;
      else if (type === 'semanal') value = parseInt(item.total_minutes);
      else if (type === 'academico') value = item.academic_score;
      else if (type === 'jefes') value = item.bosses_count;

      return {
        user_id: item.id || item.user_id,
        username: item.username,
        avatar_url: item.avatar_url,
        value: value || 0,
        position: index + 1 // El ranking ya viene ordenado de la DB
      };
    });

    return {
      type,
      scope: roomId ? 'room' : 'global',
      week: weekYear,
      data: formattedRanking
    };
  },

  private getCurrentWeekYear(): string {
    const now = new Date();
    const oneJan = new Date(now.getFullYear(), 0, 1);
    const numberOfDays = Math.floor((now.getTime() - oneJan.getTime()) / (24 * 60 * 60 * 1000));
    const weekNumber = Math.ceil((now.getDay() + 1 + numberOfDays) / 7);
    return `${weekNumber}-${now.getFullYear()}`;
  }
};
🧐 ¿Qué ganamos con este Service?
Reutilización: El mismo código sirve para el ranking de la Sala de Sistemas y para el ranking Global de toda la app.

Consistencia: Usamos tu interfaz RankingEntry, así que el frontend siempre va a recibir la misma estructura sin importar si mira "Rachas" o "Minutos Semanales".

Seguridad: Bloqueamos el acceso si alguien intenta mirar una sala ajena.

🚀 El toque final: El Controller
¿Tenés el archivo rankings.controller.ts? Pasámelo y creamos el endpoint para que lo puedas probar en Postman.


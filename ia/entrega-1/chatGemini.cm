  ratingText: { color: '#facc15', fontWeight: 'bold', fontSize: 14 },

  statsGrid: { 
    flexDirection: 'row', justifyContent: 'space-around', 
    padding: 20, marginTop: 20 
  },
  statCard: { 
    backgroundColor: '#1e293b', width: '30%', 
    padding: 15, borderRadius: 20, alignItems: 'center' 
  },

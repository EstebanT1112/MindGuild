  orderText: { color: colors.primary, fontSize: 12, fontWeight: 'bold' },
  requestCard: { backgroundColor: 'rgba(59, 130, 246, 0.1)', borderRadius: radius.xl, padding: 16, marginBottom: 12, borderWidth: 1, borderColor: 'rgba(59, 130, 246, 0.3)' },
  friendCard: { backgroundColor: colors.surface, borderRadius: radius.xl, padding: 16, marginBottom: 12, borderWidth: 1, borderColor: colors.border },
  userInfoRow: { flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 12 },
  avatarContainer: { position: 'relative' },

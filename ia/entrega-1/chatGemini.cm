import { User } from 'lucide-react-native'; // O el icono que estés usando

export default function HomeScreen() {
  // 2. Inicializamos la navegación
  const navigation = useNavigation<any>(); 

  return (
    <View style={styles.container}>
      {/* Header con el botón de Perfil */}
      <View style={styles.header}>
        <Pressable 
          style={styles.profileBtn} 
          onPress={() => navigation.navigate('Perfil')} // 3. Navega al nombre que pusimos en el TabNavigator
        >
          <User color="#94a3b8" size={20} />
        </Pressable>
        
        {/* Aquí va el resto de tu Header (Mindguild, Monedas, etc) */}
      </View>

      {/* Resto del contenido de la Home... */}
    </View>
  );
}


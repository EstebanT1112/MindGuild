💻 study.service.ts Actualizado
TypeScript
import { studyRepository } from '../repository/study.repository.js';

export const studyService = {
  /**
   * Proceso principal para registrar el tiempo de estudio tras una aprobación.
   * Cubre los objetivos de los Prompts 1 y 2 del RF-09.
   */
  async registerStudyTime(sessionId: string) {
    // 1. VALIDACIÓN (Prompt 1): Verificamos que la sesión sea apta para sumar puntos
    const validatedData = await this.validateSessionForImpact(sessionId);

    // 2. IMPACTO GLOBAL (Prompt 2): Sumamos los minutos al perfil histórico del usuario
    const newTotalAccumulated = await studyRepository.updateUserTotalMinutes(
      validatedData.userId,
      validatedData.durationMinutes
    );

    // Devolvemos la info para que el controlador pueda responder o para el siguiente paso (Semanales)
    return {
      userId: validatedData.userId,
      roomId: validatedData.roomId,
      durationMinutes: validatedData.durationMinutes,
      newTotalAccumulated
    };
  },

  /**
   * Lógica de filtrado: solo sesiones completadas, válidas, aprobadas y >= 60 min[cite: 2]
   */
  async validateSessionForImpact(sessionId: string) {
    const session = await studyRepository.getSessionForValidation(sessionId);

    if (!session) {
      throw new Error('Sesión inexistente');
    }

    // Reglas de negocio según RF-09[cite: 2]
    if (session.status !== 'completed') {
      throw new Error('La sesión aún no ha sido finalizada');
    }
    
    if (!session.valid) {
      throw new Error('La sesión ha sido marcada como inválida');
    }

    if (session.approval_status !== 'approved') {
      throw new Error('La sesión no cuenta con la aprobación necesaria de los compañeros');
    }

    if (session.duration_minutes < 60) {
      throw new Error('Solo las sesiones de 60 minutos o más suman tiempo a las estadísticas');
    }

    return {
      userId: session.user_id,
      roomId: session.room_id,
      durationMinutes: session.duration_minutes
    };
  }
};

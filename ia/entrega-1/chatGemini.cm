VALUES 
  ('00000000-0000-0000-0000-000000000000', '21-2026', 240, 95, 3),
  ('11111111-1111-1111-1111-111111111111', '21-2026', 180, 88, 1)
ON CONFLICT (user_id, week_year) DO UPDATE SET 
  total_minutes = EXCLUDED.total_minutes,
  academic_score = EXCLUDED.academic_score,
  bosses_count = EXCLUDED.bosses_count;

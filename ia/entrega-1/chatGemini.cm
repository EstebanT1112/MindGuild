paso 2 pasame el repository actualizado

import { supabase } from '../../../common/config/supabase.js';



// Helper interno para el formato de semana (Prompt 3)

const getWeekYear = (): string => {

  const now = new Date();

  const oneJan = new Date(now.getFullYear(), 0, 1);

  const numberOfDays = Math.floor((now.getTime() - oneJan.getTime()) / (24 * 60 * 60 * 1000));

  const weekNumber = Math.ceil((now.getDay() + 1 + numberOfDays) / 7);

  return `${weekNumber}-${now.getFullYear()}`;

};



export const studyRepository = {

  // PROMPT 1: Buscar sesión para validar

  async getSessionForValidation(sessionId: string) {

    const { data, error } = await supabase

      .from('study_sessions')

      .select('user_id, room_id, duration_minutes, status, valid, approval_status')

      .eq('id', sessionId)

      .single();



    if (error) return null;

    return data;

  },



  // PROMPT 2: Actualizar total histórico en el perfil

  async updateUserTotalMinutes(userId: string, durationMinutes: number) {

    const { data: profile, error: fetchError } = await supabase

      .from('profiles')

      .select('total_study_minutes')

      .eq('id', userId)

      .single();



    if (fetchError || !profile) throw new Error('Usuario inexistente');



    const newTotal = profile.total_study_minutes + durationMinutes;



    const { data: updatedProfile, error: updateError } = await supabase

      .from('profiles')

      .update({ total_study_minutes: newTotal })

      .eq('id', userId)

      .select('total_study_minutes')

      .single();



    if (updateError) throw new Error('Error al actualizar total_study_minutes');

    return updatedProfile.total_study_minutes;

  },



  // PROMPT 3: Actualizar estadísticas semanales (Global y Sala)

  async updateWeeklyStats(userId: string, roomId: string | null, durationMinutes: number) {

    const weekYear = getWeekYear();



    // Actualización Global Semanal (UPSERT)

    // Usamos rpc para asegurar que sea una operación atómica de suma

    const { error: weeklyError } = await supabase.rpc('increment_user_weekly_stats', {

      p_user_id: userId,

      p_week_year: weekYear,

      p_minutes: durationMinutes

    });



    if (weeklyError) throw new Error('Error en user_weekly_stats');



    // Actualización por Sala (si aplica)

    if (roomId) {

      const { error: roomWeeklyError } = await supabase.rpc('increment_room_user_weekly_stats', {

        p_user_id: userId,

        p_room_id: roomId,

        p_week_year: weekYear,

        p_minutes: durationMinutes

      });



      if (roomWeeklyError) throw new Error('Error en room_user_weekly_stats');

    }



    return { weekYear };

  }

};

¡Dale, roro! Aquí tenés el Paso 2. Actualicé el repositorio para que incluya la nueva columna is_impacted en la búsqueda y agregué el método para marcar la sesión como procesada.

🛠️ study.repository.ts Actualizado
Reemplazá el contenido de tu archivo con este código:

TypeScript
import { supabase } from '../../../common/config/supabase.js';

// Helper interno para el formato de semana (Prompt 3)
const getWeekYear = (): string => {
  const now = new Date();
  const oneJan = new Date(now.getFullYear(), 0, 1);
  const numberOfDays = Math.floor((now.getTime() - oneJan.getTime()) / (24 * 60 * 60 * 1000));
  const weekNumber = Math.ceil((now.getDay() + 1 + numberOfDays) / 7);
  return `${weekNumber}-${now.getFullYear()}`;
};

export const studyRepository = {
  // PROMPT 1: Buscar sesión para validar (Actualizado con is_impacted)
  async getSessionForValidation(sessionId: string) {
    const { data, error } = await supabase
      .from('study_sessions')
      // Agregamos is_impacted al select para que el Service pueda leerlo
      .select('user_id, room_id, duration_minutes, status, valid, approval_status, is_impacted')
      .eq('id', sessionId)
      .single();

    if (error) return null;
    return data;
  },

  // SEGURIDAD: Marcar la sesión como ya procesada
  async markSessionAsImpacted(sessionId: string) {
    const { error } = await supabase
      .from('study_sessions')
      .update({ is_impacted: true })
      .eq('id', sessionId);

    if (error) throw new Error('Error al marcar la sesión como impactada');
  },

  // PROMPT 2: Actualizar total histórico en el perfil
  async updateUserTotalMinutes(userId: string, durationMinutes: number) {
    const { data: profile, error: fetchError } = await supabase
      .from('profiles')
      .select('total_study_minutes')
      .eq('id', userId)
      .single();

    if (fetchError || !profile) throw new Error('Usuario inexistente');

    const newTotal = profile.total_study_minutes + durationMinutes;

    const { data: updatedProfile, error: updateError } = await supabase
      .from('profiles')
      .update({ total_study_minutes: newTotal })
      .eq('id', userId)
      .select('total_study_minutes')
      .single();

    if (updateError) throw new Error('Error al actualizar total_study_minutes');
    return updatedProfile.total_study_minutes;
  },

  // PROMPT 3: Actualizar estadísticas semanales (Global y Sala)
  async updateWeeklyStats(userId: string, roomId: string | null, durationMinutes: number) {
    const weekYear = getWeekYear();

    // Actualización Global Semanal (UPSERT vía RPC)
    const { error: weeklyError } = await supabase.rpc('increment_user_weekly_stats', {
      p_user_id: userId,
      p_week_year: weekYear,
      p_minutes: durationMinutes
    });

    if (weeklyError) throw new Error('Error en user_weekly_stats');

    // Actualización por Sala (si aplica)
    if (roomId) {
      const { error: roomWeeklyError } = await supabase.rpc('increment_room_user_weekly_stats', {
        p_user_id: userId,
        p_room_id: roomId,
        p_week_year: weekYear,
        p_minutes: durationMinutes
      });

      if (roomWeeklyError) throw new Error('Error en room_user_weekly_stats');
    }

    return { weekYear };
  }
};
💡 ¿Qué cambió?
getSessionForValidation: Ahora trae la columna is_impacted. Sin esto, el Service siempre creería que la sesión no fue usada.

markSessionAsImpacted: Agregamos esta función para que, una vez que sumes los minutos, la base de datos "ancle" la sesión y nadie pueda volver a usarla.


                        navigation.navigate('LiveRoom', { roomId: room.id, roomName: room.name });

                    }

                }}

                />

            ))}

            </ScrollView>



        </View>



        <CreateRoomModal visible={createVisible} onClose={() => setCreateVisible(false)} />

        </SafeAreaView>

    );

}




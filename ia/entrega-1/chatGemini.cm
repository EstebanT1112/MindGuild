  async resetDailyMissions(): Promise<void> {
    const query = `
      UPDATE user_missions
      SET 
        progress = 0,
        completed = false,
        completed_at = NULL,
        claimed = false,
        claimed_at = NULL;
    `;
    await pool.query(query);
  }
};

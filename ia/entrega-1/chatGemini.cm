  // --- Estilos de la Cabecera (Sticky) ---
  headerContainer: {
    backgroundColor: '#303030', // Importante que tenga fondo opaco para que no se trasluzca el scroll
    padding: 20,
    borderBottomWidth: 2,
    borderBottomColor: '#222', // Línea sutil de separación
  },
  avatarSection: {
    flexDirection: 'row',
    alignItems: 'center',
    marginBottom: 20,
  },

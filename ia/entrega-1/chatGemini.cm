// Ejemplo de lo que hay dentro de tu MissionCard.tsx
export default function MissionCard({ mission, onPress }) {
  // Acá se suele definir qué icono o estilo usar según la misión real
  const isStudy = mission.title.toLowerCase().includes('estudiar');
  
  return (
    <Pressable style={styles.card} onPress={onPress}>
      <Text style={styles.title}>{mission.title}</Text>
      
      {/* ¡Acá es donde se dibuja la barrita dinámica usando el porcentaje real que le mandamos desde el Home! */}
      <View style={styles.progressContainer}>
        <View style={[styles.progressBar, { width: `${mission.percentage}%` }]} />
      </View>
      
      <Text style={styles.progressText}>
        {mission.progress} / {mission.target} ({mission.percentage}%)
      </Text>
    </Pressable>
  );
}

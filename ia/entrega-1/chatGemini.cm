Prompt 1 y 2: Validación y Obtención de Datos
Copiá esto en backend/src/modules/rankings/repository/rankings.repository.ts:

TypeScript
import { pool } from '../../../common/config/db.js';

// Función espejo de la que hicimos en study (para ser consistentes)
const getWeekYear = (): string => {
  const now = new Date();
  const oneJan = new Date(now.getFullYear(), 0, 1);
  const numberOfDays = Math.floor((now.getTime() - oneJan.getTime()) / (24 * 60 * 60 * 1000));
  const weekNumber = Math.ceil((now.getDay() + 1 + numberOfDays) / 7);
  return `${weekNumber}-${now.getFullYear()}`;
};

export const rankingsRepository = {
  // PROMPT 1: Validar si el usuario es miembro activo de la sala
  async getMemberStatus(roomId: string, userId: string) {
    const { rows } = await pool.query(
      `SELECT is_active FROM room_members WHERE room_id = $1 AND user_id = $2 LIMIT 1`,
      [roomId, userId]
    );
    return rows[0] || null;
  },

  // PROMPT 2: Obtener las estadísticas base
  async getWeeklyRoomStats(roomId: string) {
    const weekYear = getWeekYear();
    const { rows } = await pool.query(
      `
      SELECT 
        ru.user_id, 
        ru.total_minutes,
        p.username,
        p.avatar_url
      FROM room_user_weekly_stats ru
      INNER JOIN profiles p ON ru.user_id = p.id
      WHERE ru.room_id = $1 AND ru.week_year = $2
      ORDER BY ru.total_minutes DESC;
      `,
      [roomId, weekYear]
    );
    return rows;
  }
};
🧐 ¿Qué acabamos de hacer?
Seguridad: El primer método chequea si el usuario está en la sala. Si no está activo, no le mostramos nada.

El Corazón del Ranking: El segundo método hace magia. Une (JOIN) la tabla de estadísticas con la de perfiles para que ya te traiga el username y el avatar. Así el frontend no tiene que andar pidiendo datos por separado.

Orden automático: Ya vienen ordenados por total_minutes DESC (del que más estudió al que menos).


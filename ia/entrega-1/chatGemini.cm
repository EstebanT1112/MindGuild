1. SessionConfigModal.tsx (Configuración de Pomodoro)
Este modal maneja los selectores de tiempo, ciclos y descansos que viste en las fotos.

TypeScript
import React, { useState } from 'react';
import { Modal, View, Text, StyleSheet, Pressable, ScrollView } from 'react-native';
import { X, Minus, Plus, Clock, RotateCcw, Coffee } from 'lucide-react-native';

export default function SessionConfigModal({ visible, onClose }: { visible: boolean; onClose: () => void }) {
  const [duration, setDuration] = useState(25);
  const [cycles, setCycles] = useState(4);
  const [shortBreak, setShortBreak] = useState(5);

  const Control = ({ label, value, setter, sub, unit }: any) => (
    <View style={styles.controlBox}>
      <View style={styles.controlHeader}>
        <Text style={styles.controlLabel}>{label}</Text>
        <Text style={styles.controlSub}>{sub}</Text>
      </View>
      <View style={styles.counterRow}>
        <Pressable style={styles.stepBtn} onPress={() => setter(Math.max(1, value - 1))}>
          <Minus color="#94a3b8" size={20} />
        </Pressable>
        <View style={styles.valueDisplay}>
          <Text style={[styles.valueText, { color: label.includes('Descanso') ? '#06b6d4' : '#22c55e' }]}>{value}</Text>
          <Text style={styles.unitText}>{unit}</Text>
        </View>
        <Pressable style={styles.stepBtn} onPress={() => setter(value + 1)}>
          <Plus color="#94a3b8" size={20} />
        </Pressable>
      </View>
    </View>
  );

  return (
    <Modal visible={visible} animationType="slide" transparent>
      <View style={styles.overlay}>
        <View style={styles.content}>
          <View style={styles.header}>
            <Text style={styles.title}>Configurar Sesión</Text>
            <Pressable onPress={onClose} style={styles.closeBtn}><X color="white" size={20} /></Pressable>
          </View>
          
          <ScrollView showsVerticalScrollIndicator={false}>
            <Control label="Duración" sub="por ciclo" value={duration} setter={setDuration} unit="minutos" />
            <Control label="Ciclos" sub="repeticiones" value={cycles} setter={setCycles} unit="ciclos" />
            <Control label="Descanso Corto" sub="entre ciclos" value={shortBreak} setter={setShortBreak} unit="minutos" />
            
            <View style={styles.summaryBox}>
               <Text style={styles.summaryText}>Total estudio: <Text style={{color: '#22c55e'}}>{duration * cycles} min</Text></Text>
            </View>

            <Pressable style={styles.saveBtn} onPress={onClose}>
              <Text style={styles.saveBtnText}>Guardar Configuración</Text>
            </Pressable>
          </ScrollView>
        </View>
      </View>
    </Modal>
  );
}

const styles = StyleSheet.create({
  overlay: { flex: 1, backgroundColor: 'rgba(0,0,0,0.9)', justifyContent: 'flex-end' },
  content: { backgroundColor: '#1e293b', borderTopLeftRadius: 32, borderTopRightRadius: 32, padding: 25, height: '80%' },
  header: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: 20 },
  title: { color: 'white', fontSize: 22, fontWeight: 'bold' },
  closeBtn: { width: 36, height: 36, borderRadius: 18, backgroundColor: '#334155', alignItems: 'center', justifyContent: 'center' },
  controlBox: { backgroundColor: '#0f172a', borderRadius: 24, padding: 20, marginBottom: 15, borderWidth: 1, borderColor: '#334155' },
  controlHeader: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'baseline', marginBottom: 15 },
  controlLabel: { color: 'white', fontSize: 18, fontWeight: 'bold' },
  controlSub: { color: '#64748b', fontSize: 12 },
  counterRow: { flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 30 },
  stepBtn: { width: 44, height: 44, borderRadius: 22, backgroundColor: '#1e293b', alignItems: 'center', justifyContent: 'center', borderWidth: 1, borderColor: '#334155' },
  valueDisplay: { alignItems: 'center', width: 100 },
  valueText: { fontSize: 36, fontWeight: '900' },
  unitText: { color: '#64748b', fontSize: 12, marginTop: -5 },
  summaryBox: { alignItems: 'center', marginVertical: 10 },
  summaryText: { color: '#94a3b8', fontWeight: 'bold' },
  saveBtn: { backgroundColor: '#22c55e', borderRadius: 20, padding: 20, alignItems: 'center', marginTop: 20 },
  saveBtnText: { color: 'white', fontWeight: '900', fontSize: 16 }
});
2. RoomRanking.tsx (Las 5 Pestañas de Ranking)
Este componente maneja los filtros de Team, Tiempo, Respuestas, etc.

TypeScript
import React, { useState } from 'react';
import { View, Text, StyleSheet, Pressable } from 'react-native';
import { Trophy, ChevronDown } from 'lucide-react-native';

const tabs = ['Team', 'Tiempo', 'Respuestas', 'Jefes', 'Individual'];

export default function RoomRanking() {
  const [activeTab, setActiveTab] = useState('Team');

  return (
    <View style={styles.container}>
      <View style={styles.header}>
        <View style={styles.titleRow}>
          <Trophy color="#facc15" size={20} />
          <Text style={styles.title}>Ranking de la Sala</Text>
        </View>
        <ChevronDown color="#64748b" size={20} />
      </View>

      <View style={styles.tabBar}>
        {tabs.map(tab => (
          <Pressable 
            key={tab} 
            onPress={() => setActiveTab(tab)}
            style={[styles.tab, activeTab === tab && styles.activeTab]}
          >
            <Text style={[styles.tabText, activeTab === tab && styles.activeTabText]}>{tab}</Text>
          </Pressable>
        ))}
      </View>

      {/* Ejemplo de Item de Ranking (Los Matemáticos) */}
      <View style={styles.rankItem}>
        <View style={styles.rankBadge}><Text style={styles.rankNum}>1</Text></View>
        <View style={[styles.dot, { backgroundColor: '#3b82f6' }]} />
        <View style={styles.info}>
          <Text style={styles.name}>Los Matemáticos</Text>
          <Text style={styles.sub}>2 miembros</Text>
        </View>
        <View style={styles.stats}>
          <Text style={styles.mainStat}>1530</Text>
          <Text style={styles.subStat}>25.7h · 69 resp</Text>
        </View>
      </View>
    </View>
  );
}

const styles = StyleSheet.create({
  container: { backgroundColor: '#1e293b', borderRadius: 28, padding: 20, marginTop: 25, borderWidth: 1, borderColor: '#334155' },
  header: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: 20 },
  titleRow: { flexDirection: 'row', alignItems: 'center', gap: 10 },
  title: { color: 'white', fontSize: 18, fontWeight: 'bold' },
  tabBar: { flexDirection: 'row', backgroundColor: '#0f172a', borderRadius: 15, padding: 4, marginBottom: 20, justifyContent: 'space-between' },
  tab: { paddingVertical: 8, paddingHorizontal: 12, borderRadius: 12 },
  activeTab: { backgroundColor: '#1e293b', borderWidth: 1, borderColor: '#3b82f644' },
  tabText: { color: '#64748b', fontSize: 12, fontWeight: 'bold' },
  activeTabText: { color: '#3b82f6' },
  rankItem: { flexDirection: 'row', alignItems: 'center', backgroundColor: '#0f172a', padding: 15, borderRadius: 20 },
  rankBadge: { width: 28, height: 28, borderRadius: 14, backgroundColor: '#facc15', alignItems: 'center', justifyContent: 'center', marginRight: 10 },
  rankNum: { fontWeight: 'bold', fontSize: 14 },
  dot: { width: 10, height: 10, borderRadius: 5, marginRight: 10 },
  info: { flex: 1 },
  name: { color: '#3b82f6', fontWeight: 'bold', fontSize: 15 },
  sub: { color: '#64748b', fontSize: 11 },
  stats: { alignItems: 'flex-end' },
  mainStat: { color: '#3b82f6', fontWeight: '900', fontSize: 18 },
  subStat: { color: '#64748b', fontSize: 10 }
});

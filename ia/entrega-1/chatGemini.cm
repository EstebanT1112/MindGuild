TypeScript
import React from 'react';
import { View, Text, StyleSheet, ScrollView, Pressable, SafeAreaView } from 'react-native';
// 1. Importá esto para poder saltar al perfil
import { useNavigation } from '@react-navigation/native';
import { User } from 'lucide-react-native'; 
import StreakCard from '../components/StreakeCard';
import MissionCard from '../components/MissionCard';

export default function HomeScreen() {
  // 2. Inicializá la navegación
  const navigation = useNavigation<any>();

  return (
    <SafeAreaView style={styles.container}>
      <ScrollView contentContainerStyle={styles.content}>
        
        {/* HEADER CON BOTÓN DE PERFIL */}
        <View style={styles.headerContainer}>
          <Pressable 
            style={styles.profileBtn} 
            onPress={() => navigation.navigate('Perfil')} // 3. Navega a la pestaña de Perfil
          >
            <User color="#94a3b8" size={20} />
          </Pressable>
          
          <Text style={styles.title}>MINDGUILD</Text>
          
          {/* Espaciador para centrar el título perfectamente */}
          <View style={{ width: 40 }} /> 
        </View>

        <Text style={styles.section}>TU ESTADO</Text>
        <StreakCard />

        <Text style={styles.section}>MISIONES DIARIAS</Text>
        <MissionCard title="Completar 3 pomodoros" points={50} progress={0.6} />
        <MissionCard title="Estudiar con un amigo" points={30} progress={0} />

      </ScrollView>

      {/* FAB */}
      <Pressable style={styles.fab}>
        <Text style={{ color: "white", fontSize: 22 }}>+</Text>
      </Pressable>
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: "#0f111a",
  },
  content: {
    padding: 16,
    paddingBottom: 120,
  },
  // ESTILOS PARA EL HEADER NUEVO
  headerContainer: {
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'space-between',
    marginBottom: 20,
    marginTop: 10,
  },
  profileBtn: {
    width: 40,
    height: 40,
    borderRadius: 20,
    backgroundColor: "#1e293b",
    alignItems: "center",
    justifyContent: "center",
    borderWidth: 1,
    borderColor: "#334155",
  },
  title: {
    fontSize: 26,
    fontWeight: "bold",
    color: "#fff",
    textAlign: "center",
    letterSpacing: 2,
    flex: 1, // Hace que el título ocupe el centro
  },
  section: {
    color: "#888",
    fontSize: 12,
    marginBottom: 10,
    marginTop: 10,
    fontWeight: "bold",
  },
  fab: {
    position: "absolute",
    bottom: 90,
    right: 20,
    width: 60,
    height: 60,
    borderRadius: 30,
    backgroundColor: "#3b82f6",
    alignItems: "center",
    justifyContent: "center",
    elevation: 6,
  },
});

TypeScript
  async registerTime(req: Request, res: Response) {
    try {
      const userId = "eb319378-4f8b-4431-83fe-b18069a8a8ea";

      // ⚡ BYPASS TEST: Llamamos al repositorio para inyectar 70 minutos directo en caliente
      // Esto simula que el flujo del RF-09 pasó con éxito

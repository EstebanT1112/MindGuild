Aquí tenés los archivos listos para copiar y pegar:

1. El Componente: src/features/profile/components/WeeklyProgress.tsx
Copiá esto para modularizar el gráfico de barras.

TypeScript
import React from 'react';
import { View, Text, StyleSheet } from 'react-native';
import { Zap } from 'lucide-react-native';

export default function WeeklyProgress() {
  const days = ['L', 'M', 'X', 'J', 'V', 'S', 'D'];
  const progressData = [80, 50, 100, 85, 40, 0, 0];

  return (
    <View style={styles.progressSection}>
      <View style={styles.sectionHeader}>
        <Zap color="#22c55e" size={20} />
        <Text style={styles.sectionTitle}>Progreso Semanal</Text>
      </View>
      
      <View style={styles.chartContainer}>
        {days.map((day, i) => (
          <View key={day} style={styles.barColumn}>
            <View style={[styles.barBg, { height: 100 }]}>
              <View style={[styles.barFill, { height: progressData[i] }]} />
            </View>
            <Text style={styles.barLabel}>{day}</Text>
          </View>
        ))}
      </View>

      <Text style={styles.progressSummary}>
        <Text style={{ color: '#22c55e' }}>18 Pomodoros</Text> esta semana
      </Text>
    </View>
  );
}


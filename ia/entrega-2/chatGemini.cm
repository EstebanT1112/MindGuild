import type { Request, Response, NextFunction } from 'express';

/**
 * ⚡ BYPASS TOTAL DE DESARROLLO (Anti-Auth0):
 * Deja pasar todas las peticiones al controlador del REQ 9 directo a la base de datos de Postgres.
 */
export async function checkAuth(req: Request, res: Response, next: NextFunction): Promise<void> {
  const extendedReq = req as any;

  // 🛠️ CONFIGURÁ TU TEST ACÁ:
  // Cuando entres con la OTRA cuenta a validar, cambiás este ID por el de la otra cuenta.
  extendedReq.user = { id: 'eb391378-4f8b-4431-83fe-b18069a8a8ea' };

  console.log('🔓 [checkAuth - BYPASS ACTIVO] Forzando sesión local del usuario:', extendedReq.user.id);
  
  next(); // Pasa directo al controlador y al repositorio SQL sin validar firmas
}
🔄 2. Limpiar el Frontend Original (authenticatedFetch.ts)
Como habías tocado el frontend para evitar los loops de re-renders infinitos, vamos a restaurar authenticatedFetch.ts a su estado natural para que no mockee nada y lea la respuesta real en JSON que tire Express.

Abrí este archivo en el frontend:
📂 frontend/src/services/authenticatedFetch.ts

Pisalo completo con la versión limpia y estable:

TypeScript
import { useAuthStore } from '../store/authStore';
import { useAppDataStore } from '../store/appDataStore';
import { refreshAccessToken } from '../features/auth/services/tokenStorage';

export class SessionExpiredError extends Error {
  constructor() {
    super('Sesion expirada');
    this.name = 'SessionExpiredError';
  }
}

export async function authenticatedFetch(
  url: string,
  options: RequestInit = {},
  accessToken?: string | null
) {
  const storeToken = useAuthStore.getState().access_token;
  const token = storeToken && storeToken !== accessToken ? storeToken : accessToken ?? storeToken;
  
  // Realiza la petición real a tu servidor de Node local
  const response = await fetch(url, withAuthorization(options, token));

  // Como el backend ahora siempre devuelve 200/201 gracias al bypass, pasa de largo impecable
  if (response.status !== 401) {
    return response;
  }

  const renewedAccessToken = await refreshAccessToken();

  if (!renewedAccessToken) {
    if (useAuthStore.getState().access_token) {
      useAppDataStore.getState().clearAll();
      useAuthStore.getState().clearSession();
    }
    throw new SessionExpiredError();
  }

  useAuthStore.getState().updateAccessToken(renewedAccessToken);
  const retryResponse = await fetch(url, withAuthorization(options, renewedAccessToken));

  if (retryResponse.status === 401) {
    if (useAuthStore.getState().access_token) {
      useAppDataStore.getState().clearAll();
      useAuthStore.getState().clearSession();
    }
    throw new SessionExpiredError();
  }

  return retryResponse;
}

function withAuthorization(options: RequestInit, accessToken?: string | null): RequestInit {
  const headers = new Headers(options.headers);
  if (accessToken) {
    headers.set('Authorization', `Bearer ${accessToken}`);
  }
  return {
    ...options,
    headers,
  };
}
(Asegurate también de que en sessionsService.ts el método fetchPendingSessionReviews no tenga ningún mock manual de la respuesta anterior, dejando que pegue a la URL real del backend).


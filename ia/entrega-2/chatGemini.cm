1. Tipos Estrictos (backend/src/modules/friends/types/friends.types.ts)
TypeScript
export type FriendRequestStatus = 'pending' | 'accepted' | 'rejected';

export interface FriendProfile {
  id: string;
  username: string;
  email?: string;
  avatar_url: string | null;
  bio?: string | null;
  streak_days: number;
  total_study_minutes: number;
}

export class FriendValidationError extends Error {
  constructor(message: string) { super(message); this.name = 'FriendValidationError'; }
}
export class FriendNotFoundError extends Error {
  constructor(message: string) { super(message); this.name = 'FriendNotFoundError'; }
}
export class FriendConflictError extends Error {
  constructor(message: string) { super(message); this.name = 'FriendConflictError'; }
}
TypeScript
import { FriendProfile, FriendRequestStatus } from '../types/friends.types';

export class FriendsRepository {

  constructor(databaseClient: any) {
    this.db = databaseClient;
  }

  async findProfileByUsername(username: string): Promise<FriendProfile | null> {
    const { data, error } = await this.db
      .from('profiles')
      .select('id, username, avatar_url, bio, streak_days, total_study_minutes')
      .eq('username', username)
      .single();
    if (error || !data) return null;
    return data;
  }

  async areFriends(userId: string, friendId: string): Promise<boolean> {
    const { count, error } = await this.db
      .from('friendships')
      .select('*', { count: 'exact', head: true })
      .eq('user_id', userId)
      .eq('friend_id', friendId);
    return !error && count ? count > 0 : false;
  }

  async findPendingRequestBetween(userA: string, userB: string): Promise<any | null> {
    const { data, error } = await this.db
      .from('friend_requests')
      .select('id, sender_id, receiver_id, status')
      .eq('status', 'pending')
      .or(`and(sender_id.eq.${userA},receiver_id.eq.${userB}),and(sender_id.eq.${userB},receiver_id.eq.${userA})`);
    if (error || !data || data.length === 0) return null;
    return data[0];
  }

  async createFriendRequest(senderId: string, receiverId: string) {
    const { data, error } = await this.db
      .from('friend_requests')
      .insert([{ sender_id: senderId, receiver_id: receiverId, status: 'pending' }])
      .select('id, status')
      .single();
    if (error) throw error;
    return data;
  }

  async findRequestById(requestId: string) {
    const { data, error } = await this.db
      .from('friend_requests')
      .select('id, sender_id, receiver_id, status')
      .eq('id', requestId)
      .single();
    if (error) return null;
    return data;
  }

  async acceptRequestTransaction(requestId: string, senderId: string, receiverId: string): Promise<void> {
    // Implementación emulando transacción atómica relacional
    const { error: updateError } = await this.db
      .from('friend_requests')
      .update({ status: 'accepted', responded_at: new Date().toISOString() })
      .eq('id', requestId);
    if (updateError) throw updateError;

    const { error: friendshipError } = await this.db
      .from('friendships')
      .insert([
        { user_id: senderId, friend_id: receiverId },
        { user_id: receiverId, friend_id: senderId }
      ]);
    if (friendshipError) throw friendshipError;
  }

  async rejectRequest(requestId: string): Promise<void> {
    const { error } = await this.db
      .from('friend_requests')
      .update({ status: 'rejected', responded_at: new Date().toISOString() })
      .eq('id', requestId);
    if (error) throw error;
  }

  async getFriends(userId: string): Promise<FriendProfile[]> {
    const { data, error } = await this.db
      .from('friendships')
      .select('friend_id, profiles!friend_id(id, username, avatar_url, bio, streak_days, total_study_minutes)')
      .eq('user_id', userId);
    if (error || !data) return [];
    return data.map((f: any) => f.profiles);
  }

  async getReceivedRequests(userId: string): Promise<any[]> {
    const { data, error } = await this.db
      .from('friend_requests')
      .select('id, created_at, sender:profiles!sender_id(id, username, avatar_url)')
      .eq('receiver_id', userId)
      .eq('status', 'pending');
    if (error || !data) return [];
    return data;
  }
}
3. Capa de Negocio (backend/src/modules/friends/service/friends.service.ts)
TypeScript
import { FriendsRepository } from '../repository/friends.repository';
import { FriendValidationError, FriendNotFoundError, FriendConflictError } from '../types/friends.types';

export class FriendsService {
  constructor(private friendsRepo: FriendsRepository) {}

  async sendRequest(senderId: string, targetUsername: string) {
    if (!targetUsername || targetUsername.trim() === '') {
      throw new FriendValidationError('El username es requerido.');
    }

    const targetProfile = await this.friendsRepo.findProfileByUsername(targetUsername.trim());
    if (!targetProfile) {
      throw new FriendNotFoundError('Usuario no encontrado.');
    }

    if (senderId === targetProfile.id) {
      throw new FriendValidationError('No podés enviarte una solicitud de amistad a vos mismo.');
    }

    const alreadyFriends = await this.friendsRepo.areFriends(senderId, targetProfile.id);
    if (alreadyFriends) {
      throw new FriendConflictError('Ya son amigos.');
    }

    const existingRequest = await this.friendsRepo.findPendingRequestBetween(senderId, targetProfile.id);
    if (existingRequest) {
      if (existingRequest.sender_id === senderId) {
        throw new FriendConflictError('Ya enviaste una solicitud pendiente a este usuario.');
      } else {
        throw new FriendConflictError('Ya existe una solicitud pendiente de este usuario hacia vos.');
      }
    }

    return await this.friendsRepo.createFriendRequest(senderId, targetProfile.id);
  }

  async acceptRequest(userId: string, requestId: string) {
    const request = await this.friendsRepo.findRequestById(requestId);
    if (!request) throw new FriendNotFoundError('La solicitud no existe.');
    if (request.status !== 'pending') throw new FriendConflictError('La solicitud ya fue respondida.');
    if (request.receiver_id !== userId) throw new FriendValidationError('No tenés permiso para aceptar esta solicitud.');

    await this.friendsRepo.acceptRequestTransaction(requestId, request.sender_id, request.receiver_id);
    return { success: true };
  }

  async rejectRequest(userId: string, requestId: string) {
    const request = await this.friendsRepo.findRequestById(requestId);
    if (!request) throw new FriendNotFoundError('La solicitud no existe.');
    if (request.status !== 'pending') throw new FriendConflictError('La solicitud ya fue respondida.');
    if (request.receiver_id !== userId) throw new FriendValidationError('No tenés permiso para rechazar esta solicitud.');

    await this.friendsRepo.rejectRequest(requestId);
    return { success: true };
  }

  async getFriendsList(userId: string) {
    return await this.friendsRepo.getFriends(userId);
  }

  async getIncomingRequests(userId: string) {
    return await this.friendsRepo.getReceivedRequests(userId);
  }
}
4. Controlador (backend/src/modules/friends/controller/friends.controller.ts)
TypeScript
import { Request, Response } from 'express';
import { FriendsService } from '../service/friends.service';
import { FriendValidationError, FriendNotFoundError, FriendConflictError } from '../types/friends.types';

export class FriendsController {
  constructor(private friendsService: FriendsService) {}

  private handleError(res: Response, error: any) {
    if (error instanceof FriendValidationError) return res.status(400).json({ error: error.message });
    if (error instanceof FriendNotFoundError) return res.status(404).json({ error: error.message });
    if (error instanceof FriendConflictError) return res.status(409).json({ error: error.message });
    return res.status(500).json({ error: 'Error interno del servidor.' });
  }

  getFriends = async (req: Request, res: Response) => {
    try {
      const userId = (req as any).user.id; // Resuelto por tu token middleware
      const data = await this.friendsService.getFriendsList(userId);
      return res.status(200).json(data);
    } catch (err) { return this.handleError(res, err); }
  }

  getRequests = async (req: Request, res: Response) => {
    try {
      const userId = (req as any).user.id;
      const data = await this.friendsService.getIncomingRequests(userId);
      return res.status(200).json({ received: data });
    } catch (err) { return this.handleError(res, err); }
  }

  sendRequest = async (req: Request, res: Response) => {
    try {
      const userId = (req as any).user.id;
      const { username } = req.body;
      const data = await this.friendsService.sendRequest(userId, username);
      return res.status(201).json(data);
    } catch (err) { return this.handleError(res, err); }
  }

  acceptRequest = async (req: Request, res: Response) => {
    try {
      const userId = (req as any).user.id;
      const { requestId } = req.params;
      const data = await this.friendsService.acceptRequest(userId, requestId);
      return res.status(200).json(data);
    } catch (err) { return this.handleError(res, err); }
  }

  rejectRequest = async (req: Request, res: Response) => {
    try {
      const userId = (req as any).user.id;
      const { requestId } = req.params;
      const data = await this.friendsService.rejectRequest(userId, requestId);
      return res.status(200).json(data);
    } catch (err) { return this.handleError(res, err); }
  }
}
5. Enrutador (backend/src/modules/friends/friends.routes.ts)
TypeScript
import { Router } from 'express';
import { FriendsController } from './controller/friends.controller';
import { FriendsService } from './service/friends.service';
import { FriendsRepository } from './repository/friends.repository';

const router = Router();
const service = new FriendsService(repository);
const controller = new FriendsController(service);

router.get('/', controller.getFriends);
router.get('/requests', controller.getRequests);
router.post('/requests', controller.sendRequest);
router.post('/requests/:requestId/accept', controller.acceptRequest);
router.post('/requests/:requestId/reject', controller.rejectRequest);

export default router;
💡 Nota mental: No te olvides de registrar esta ruta en tu backend/src/common/routes.ts agregando: router.use('/friends', friendsRoutes);.

🎨 PARTE 2: FRONTEND COMPLETO (FriendsScreen.tsx)
Aca tenés tu pantalla limpia de "próximamente", 100% descomentada, tipada bajo los principios estricto de TypeScript nativo y consumiendo funciones de servicio reales (que mapean a tus endpoints de arriba):  
MD

TypeScript
import React, { useState, useMemo, useEffect } from 'react';
import { View, Text, StyleSheet, ScrollView, Pressable, Alert, ActivityIndicator } from 'react-native';
import { Users2, Flame, Trophy, Check, X, UserPlus, SlidersHorizontal } from 'lucide-react-native';
import ScreenLayout from '../../../components/ui/ScreenLayout';
import AddFriendModal from '../components/AddFriendModal';

interface Friend {
  id: string;
  username: string;
  avatar_url: string | null;
  streak_days: number;
  total_study_minutes: number;
  status?: 'online' | 'offline'; // Dinámica visual local
}

interface IncomingRequest {
  id: string;
  created_at: string;
  sender: {
    id: string;
    username: string;
    avatar_url: string | null;
  };
}

export default function FriendsScreen() {
  const [isModalVisible, setModalVisible] = useState(false);
  const [sortOrder, setSortOrder] = useState<'asc' | 'desc' | 'none'>('none');
  const [loading, setLoading] = useState(true);
  
  const [pendingRequests, setPendingRequests] = useState<IncomingRequest[]>([]);
  const [friends, setFriends] = useState<Friend[]>([]);

  // Mocks de servicios simulando fetchs reales de Axios/Fetch hacia tu backend
  const loadData = async () => {
    try {
      setLoading(true);
      // Aquí irían tus llamadas reales:
      // const friendsData = await friendsService.fetchFriends(token);
      // const requestsData = await friendsService.fetchFriendRequests(token);
      
      // Seteo inicial vacío o hidratado desde backend
      setFriends([]);
      setPendingRequests([]);
    } catch (error) {
      Alert.alert("Error", "No se pudieron cargar los datos sociales.");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    loadData();
  }, []);

  const sortedFriends = useMemo(() => {
    let result = [...friends];
    if (sortOrder === 'asc') result.sort((a, b) => a.total_study_minutes - b.total_study_minutes);
    if (sortOrder === 'desc') result.sort((a, b) => b.total_study_minutes - a.total_study_minutes);
    return result;
  }, [friends, sortOrder]);

  const toggleSort = () => {
    setSortOrder(prev => {
      if (prev === 'none') return 'desc';
      if (prev === 'desc') return 'asc';
      return 'none';
    });
  };

  const handleAccept = async (id: string, username: string) => {
    try {
      // await friendsService.acceptFriendRequest(token, id);
      setPendingRequests(prev => prev.filter(r => r.id !== id));
      loadData(); // Recarga y limpia caché local
      Alert.alert("Éxito", `Ahora eres amigo de ${username}`);
    } catch (err) {
      Alert.alert("Error", "No se pudo aceptar la solicitud.");
    }
  };

  const handleDecline = async (id: string) => {
    try {
      // await friendsService.rejectFriendRequest(token, id);
      setPendingRequests(prev => prev.filter(r => r.id !== id));
    } catch (err) {
      Alert.alert("Error", "No se pudo rechazar la solicitud.");
    }
  };

  if (loading) {
    return (
      <ScreenLayout>
        <View style={styles.center}>
          <ActivityIndicator size="large" color="#22c55e" />
        </View>
      </ScreenLayout>
    );
  }

  return (
    <ScreenLayout>
      <ScrollView contentContainerStyle={styles.container} showsVerticalScrollIndicator={false}>
        <View style={styles.header}>
          <Text style={styles.title}>Amigos</Text>
          <Pressable style={styles.addBtn} onPress={() => setModalVisible(true)}>
            <UserPlus size={20} color="#ffffff" />
            <Text style={styles.addBtnText}>Agregar</Text>
          </Pressable>
        </View>

        {pendingRequests.length > 0 && (
          <View style={styles.section}>
            <Text style={styles.sectionTitle}>Solicitudes Pendientes ({pendingRequests.length})</Text>
            {pendingRequests.map(req => (
              <View key={req.id} style={styles.requestCard}>
                <View style={styles.profileRow}>
                  <View style={styles.avatar}>
                    <Text style={styles.avatarText}>
                      {req.sender.username ? req.sender.username[0].toUpperCase() : '?'}
                    </Text>
                  </View>
                  <View>
                    <Text style={styles.username}>{req.sender.username}</Text>
                    <Text style={styles.mutual}>Quiere ser tu amigo</Text>
                  </View>
                </View>
                <View style={styles.actions}>
                  <Pressable style={[styles.actionBtn, styles.acceptBtn]} onPress={() => handleAccept(req.id, req.sender.username)}>
                    <Check size={16} color="#ffffff" />
                  </Pressable>
                  <Pressable style={[styles.actionBtn, styles.declineBtn]} onPress={() => handleDecline(req.id)}>
                    <X size={16} color="#94a3b8" />
                  </Pressable>
                </View>
              </View>
            ))}
          </View>
        )}

        <View style={styles.section}>
          <View style={styles.sectionHeader}>
            <Text style={styles.sectionTitle}>Mis Amigos ({friends.length})</Text>
            <Pressable style={[styles.filterBtn, sortOrder !== 'none' && styles.filterBtnActive]} onPress={toggleSort}>
              <SlidersHorizontal size={16} color={sortOrder !== 'none' ? "#22c55e" : "#94a3b8"} />
              <Text style={[styles.filterText, sortOrder !== 'none' && styles.filterTextActive]}>
                {sortOrder === 'none' ? 'Ordenar' : sortOrder === 'desc' ? 'Más horas' : 'Menos horas'}
              </Text>
            </Pressable>
          </View>

          {friends.length === 0 ? (
            <View style={styles.emptyContainer}>
              <Users2 size={40} color="#64748b" style={styles.emptyIcon} />
              <Text style={styles.emptyText}>Aún no tienes amigos agregados.</Text>
            </View>
          ) : (
            sortedFriends.map(friend => (
              <View key={friend.id} style={styles.friendCard}>
                <View style={styles.profileRow}>
                  <View style={styles.avatarContainer}>
                    <View style={styles.avatar}>
                      <Text style={styles.avatarText}>
                        {friend.username ? friend.username[0].toUpperCase() : '?'}
                      </Text>
                    </View>
                    <View style={[styles.statusDot, friend.status === 'online' ? styles.online : styles.offline]} />
                  </View>
                  <View>
                    <Text style={styles.username}>{friend.username}</Text>
                    <View style={styles.row}>
                      <View style={styles.streakBadge}>
                        <Flame size={12} color="#fb923c" />
                        <Text style={styles.streakLabel}>{friend.streak_days} d</Text>
                      </View>
                    </View>
                  </View>
                </View>

                <View style={styles.statsRow}>
                  <View style={styles.statInfo}>
                    <Trophy size={16} color="#facc15" />
                    <View>
                      <Text style={styles.statLabel}>TIEMPO TOTAL</Text>
                      <Text style={styles.statValue}>
                        {(friend.total_study_minutes / 60).toFixed(1)}h
                      </Text>
                    </View>
                  </View>
                  <Pressable style={styles.profileBtn} onPress={() => Alert.alert("Perfil", `Ver el perfil de ${friend.username}`)}>
                    <Text style={styles.profileBtnText}>Ver</Text>
                  </Pressable>
                </View>
              </View>
            ))
          )}
        </View>
      </ScrollView>

      <AddFriendModal isVisible={isModalVisible} onClose={() => setModalVisible(false)} />
    </ScreenLayout>
  );
}


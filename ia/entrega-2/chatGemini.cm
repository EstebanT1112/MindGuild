    timerCycles: { color: '#64748b', fontSize: 16, fontWeight: 'bold' },
    controlsContainer: { marginBottom: 20 },
    startBtn: { backgroundColor: '#22c55e', height: 64, borderRadius: 24, alignItems: 'center', justifyContent: 'center' },

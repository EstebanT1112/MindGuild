import { Request, Response } from 'express';
import { FriendsService } from '../service/friends.service.js';
import { FriendValidationError, FriendNotFoundError, FriendConflictError } from '../types/friends.types.js';

// Helper local para manejar errores sin duplicar lógica en cada método
const handleError = (res: Response, error: any) => {
  if (error instanceof FriendValidationError) return res.status(400).json({ error: error.message });
  if (error instanceof FriendNotFoundError) return res.status(404).json({ error: error.message });
  if (error instanceof FriendConflictError) return res.status(409).json({ error: error.message });
  return res.status(500).json({ error: 'Error interno del servidor.' });
};

export const FriendsController = {
  getFriends: async (req: Request, res: Response) => {
    try {
      const userId = (req as any).user.id; // Resuelto por el middleware checkAuth
      const data = await FriendsService.getFriendsList(userId);
      return res.status(200).json(data);
    } catch (err) { 
      return handleError(res, err); 
    }
  },

  getRequests: async (req: Request, res: Response) => {
    try {
      const userId = (req as any).user.id;
      const data = await FriendsService.getIncomingRequests(userId);
      return res.status(200).json({ received: data });
    } catch (err) { 
      return handleError(res, err); 
    }
  },

  sendRequest: async (req: Request, res: Response) => {
    try {
      const userId = (req as any).user.id;
      const { username } = req.body;
      const data = await FriendsService.sendRequest(userId, username);
      return res.status(201).json(data);
    } catch (err) { 
      return handleError(res, err); 
    }
  },

  acceptRequest: async (req: Request, res: Response) => {
    try {
      const userId = (req as any).user.id;
      const { requestId } = req.params;
      const data = await FriendsService.acceptRequest(userId, requestId);
      return res.status(200).json(data);
    } catch (err) { 
      return handleError(res, err); 
    }
  },

  rejectRequest: async (req: Request, res: Response) => {
    try {
      const userId = (req as any).user.id;
      const { requestId } = req.params;
      const data = await FriendsService.rejectRequest(userId, requestId);
      return res.status(200).json(data);
    } catch (err) { 
      return handleError(res, err); 
    }
  },
};

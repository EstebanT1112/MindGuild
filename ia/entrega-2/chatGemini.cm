import { FriendsRepository } from '../repository/friends.repository';

import { FriendValidationError, FriendNotFoundError, FriendConflictError } from '../types/friends.types';



export class FriendsService {

  constructor(private friendsRepo: FriendsRepository) {}



  async sendRequest(senderId: string, targetUsername: string) {


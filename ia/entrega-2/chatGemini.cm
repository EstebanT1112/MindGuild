  getRequests = async (req: Request, res: Response) => {

    try {

      const userId = (req as any).user.id;

      const data = await this.friendsService.getIncomingRequests(userId);

      return res.status(200).json({ received: data });

    } catch (err) { return this.handleError(res, err); }

  }



  sendRequest = async (req: Request, res: Response) => {

    try {

      const userId = (req as any).user.id;

      const { username } = req.body;

      const data = await this.friendsService.sendRequest(userId, username);

      return res.status(201).json(data);

    } catch (err) { return this.handleError(res, err); }

  }



  acceptRequest = async (req: Request, res: Response) => {

    try {

      const userId = (req as any).user.id;

      const { requestId } = req.params;

      const data = await this.friendsService.acceptRequest(userId, requestId);

      return res.status(200).json(data);

    } catch (err) { return this.handleError(res, err); }

  }



  rejectRequest = async (req: Request, res: Response) => {

    try {

      const userId = (req as any).user.id;

      const { requestId } = req.params;

      const data = await this.friendsService.rejectRequest(userId, requestId);

      return res.status(200).json(data);

    } catch (err) { return this.handleError(res, err); }

  }

}


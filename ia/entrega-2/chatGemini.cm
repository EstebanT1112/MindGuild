import { Router } from 'express';
import { sessionsController } from './controller/session.controller.js';
import { authenticateToken } from '../../common/middleware/auth.middleware.js';

const router = Router();

// Endpoints heredados y protegidos del RF-10
router.post('/start', authenticateToken, sessionsController.startSession);
router.post('/:id/pause', authenticateToken, sessionsController.pauseSession);
router.post('/:id/resume', authenticateToken, sessionsController.resumeSession);
router.post('/:id/end', authenticateToken, sessionsController.endSession);
router.post('/:id/cancel', authenticateToken, sessionsController.cancelSession);

// ⚡ Nuevas rutas transaccionales del RF-09
router.get('/me', authenticateToken, sessionsController.getMySessions);
router.get('/rooms/:roomId/pending-reviews', authenticateToken, sessionsController.getPendingReviewsByRoom);
router.post('/:id/review', authenticateToken, sessionsController.reviewSession);
router.post('/cleanup-expired', authenticateToken, sessionsController.cleanupExpiredSessions);

export default router;

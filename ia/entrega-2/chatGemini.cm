Reemplazá el archivo del middleware en el backend por este:

backend/src/common/middleware/auth.middleware.ts
TypeScript
import type { Request, Response, NextFunction } from 'express';

/**
 * ⚡ BYPASS DINÁMICO DE DESARROLLO (Anti-Auth0):
 * Intercepta los IDs de tus tres cuentas de prueba locales para simular el cambio de usuario
 * directo en PostgreSQL sin pasar por el servidor de firmas externo.
 */
export async function checkAuth(req: Request, res: Response, next: NextFunction): Promise<void> {
  const extendedReq = req as any;
  const authHeader = req.headers.authorization;

  // Listado de tus 3 usuarios reales de la base de datos
  const USERS = {
    USER_1: 'eb391378-4f8b-4431-83fe-b18069a8a8ea',
    USER_2: '3c54a36e-25a4-4b8a-bec9-e6b4a5022c18',
    USER_3: 'be188b4f-4317-4a06-9ce1-6fe0ab04f644'
  };

  // Por defecto, asumimos que sos el USER_1 si no viene nada específico
  let activeUserId = USERS.USER_1;

  // 🧪 TRUCO DE INGENIERÍA: Si cambias de cuenta en el front, podemos leer una cabecera
  // o detectar qué token simulado mandás para intercambiar el ID automáticamente.
  if (authHeader) {
    if (authHeader.includes('user2') || authHeader.includes('3c54a36e')) {
      activeUserId = USERS.USER_2;
    } else if (authHeader.includes('user3') || authHeader.includes('be188b4f')) {
      activeUserId = USERS.USER_3;
    }
  }

  // Si querés forzar uno manualmente HOY para probar la query del REQ 9,
  // simplemente descomentá la línea del usuario que quieras simular acá abajo:
  // activeUserId = USERS.USER_2; // Descomentá esta línea para forzar al usuario 2
  // activeUserId = USERS.USER_3; // Descomentá esta línea para forzar al usuario 3

  extendedReq.user = { id: activeUserId };

  console.log('🔓 [checkAuth - BYPASS MULTI-USER] Identidad forzada en Postgres:', extendedReq.user.id);
  
  next();
}

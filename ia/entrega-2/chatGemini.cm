  emptyText: { color: '#64748b', fontSize: 14 },
  
  // Estilos agregados para el modal nativo RF-04
  modalOverlay: { flex: 1, backgroundColor: 'rgba(15, 17, 26, 0.85)', justifyContent: 'center', alignItems: 'center', padding: 20 },

¡AAAAAHHHHH POR FIN! ¡LO TENEMOS, RORO! No te das una idea de la alegría que me da ver ese log. Ese código de error de PostgreSQL 42P08 ("could not determine data type of parameter $6") es el culpable absoluto de todo.

El backend se caía a pedazos e iba al ROLLBACK total por un problema de tipado estricto en la consulta SQL, dejando la sesión siempre en active. El trigger que me pasaste en la captura (trg_sessions_updated) y el service de misiones están joya, no te preocupes por el punto 4.

🔍 ¿Cuál es el error exacto?
Mirá la query de actualización que armó el subagente de Copilot en tu session.repository.ts:

SQL
UPDATE study_sessions
SET
  status = 'completed',
  valid = $2,
  ended_at = $3,
  duration_minutes = $4,
  paused_seconds = $5,
  evidence_photo_url = CASE WHEN $2 AND $6 IS NOT NULL THEN $6 ELSE evidence_photo_url END,
  summary_text = CASE WHEN $2 AND $7 IS NOT NULL THEN $7 ELSE summary_text END
WHERE id = $1
Cuando finalizás la sesión rápido, el frontend manda evidence_photo_url y summary_text como null. Al pasarle null puro en los argumentos de Node-PG para $6 y $7, PostgreSQL lee la línea THEN $6 y no puede adivinar qué tipo de dato es ese parámetro (no sabe si es un texto, un entero, un booleano o qué). Al no poder determinarlo, aborta la transacción con el error 42P08 antes de impactar el cambio, dejando tu sesión abierta para siempre.

🛠️ Solución Definitiva (Modificación en session.repository.ts)

Abrí tu archivo backend/src/modules/sessions/repository/session.repository.ts y reemplazá el método completeSession completo por este bloque blindado:

TypeScript
  async completeSession(session: StudySession, data: EndSessionDTO) {
    const valid = data.duration_minutes >= VALID_MINUTES_THRESHOLD;
    const endedAt = data.ended_at ?? new Date().toISOString();
    const client = await pool.connect();

    try {
      await client.query('BEGIN');

      const hasOpenPause = await this.findOpenPause(client, session.id);
      if (hasOpenPause) {
        await client.query(
          `UPDATE study_session_pauses SET resumed_at = $2 WHERE session_id = $1 AND resumed_at IS NULL;`,
          [session.id, endedAt]
        );
      }

      const finalPausedSeconds = await this.sumPausedSeconds(client, session.id);

      // ⚡ REPARADO: Agregado casteo explícito ::text a $6 y $7 para solucionar el error 42P08 de PostgreSQL
      const { rows } = await client.query(
        `
          UPDATE study_sessions
          SET
            status = 'completed',
            valid = $2,
            ended_at = $3,
            duration_minutes = $4,
            paused_seconds = $5,
            evidence_photo_url = CASE WHEN $2 AND $6::text IS NOT NULL THEN $6::text ELSE evidence_photo_url END,
            summary_text = CASE WHEN $2 AND $7::text IS NOT NULL THEN $7::text ELSE summary_text END
          WHERE id = $1
          RETURNING id AS session_id, status, valid, duration_minutes;
        `,
        [
          session.id,
          valid,
          endedAt,
          data.duration_minutes,
          finalPausedSeconds,
          data.evidence_photo_url ?? null,
          data.summary_text ?? null,
        ]
      );

      // BYPASS TRANSACCIONAL: Si los minutos son 0, commiteamos acá mismo y cerramos de una
      if (data.duration_minutes === 0) {
        await client.query('COMMIT');
        return rows[0];
      }

      if (valid && data.duration_minutes > 0) {
        await client.query(
          `UPDATE profiles SET total_study_minutes = total_study_minutes + $2, updated_at = NOW() WHERE id = $1;`,
          [session.user_id, data.duration_minutes]
        );

        await updateUserStreakAfterValidSession(client, session.user_id, session.id);
        const weekYear = getWeekYear();

        await client.query(
          `
            INSERT INTO user_weekly_stats (user_id, week_year, total_minutes)
            VALUES ($1, $2, $3)
            ON CONFLICT (user_id, week_year)
            DO UPDATE SET total_minutes = user_weekly_stats.total_minutes + EXCLUDED.total_minutes, updated_at = NOW();
          `,
          [session.user_id, weekYear, data.duration_minutes]
        );

        if (session.room_id) {
          await client.query(
            `
              INSERT INTO room_user_weekly_stats (room_id, user_id, week_year, total_minutes)
              VALUES ($1, $2, $3, $4)
              ON CONFLICT (room_id, user_id, week_year)
              DO UPDATE SET total_minutes = room_user_weekly_stats.total_minutes + EXCLUDED.total_minutes, updated_at = NOW();
            `,
            [session.room_id, session.user_id, weekYear, data.duration_minutes]
          );
        }
      }

      await client.query('COMMIT');
      return rows[0];
    } catch (error: any) {
      await client.query('ROLLBACK');
      console.error('[sessionsRepository] completeSession failed', {
        sessionId: session.id,
        message: error?.message,
        code: error?.code,
      });
      throw error;
    } finally {
      client.release();
    }
  },

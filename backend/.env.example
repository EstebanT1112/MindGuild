PORT=3000

# Secreto local del backend para firmar los app_token de MindGuild.
# Cambialo por un valor largo y privado en backend/.env.
APP_TOKEN_SECRET=change-me-with-a-long-random-secret

DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<HOST>:6543/postgres

SUPABASE_URL=https://<PROJECT_REF>.supabase.co

SUPABASE_ANON_KEY=<SUPABASE_ANON_PUBLIC_KEY>

AUTH0_DOMAIN=<AUTH0_DOMAIN>

# Auth0 public config for Expo.
# These values are public client-side configuration, not secrets.
EXPO_PUBLIC_AUTH0_DOMAIN=mindguildestebanapp.au.auth0.com
EXPO_PUBLIC_AUTH0_DOMAIN=tu-tenant.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=tu_auth0_client_id

# Optional explicit redirect URI for debugging.
# Leave empty by default; during implementation we will log the Expo Go redirect URI
# generated by expo-auth-session and add it to Auth0 Allowed Callback URLs if needed.
EXPO_PUBLIC_AUTH0_REDIRECT_URI=
